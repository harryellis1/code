              </div>
            </div>

            <div className="bg-slate-800/50 p-4 rounded-lg">
              <div className="flex items-center justify-between mb-2">
                <label className="text-sm font-medium">Trading Execution Speed</label>
                <span className="text-sm text-slate-400">{(tradingSpeed / 1000).toFixed(1)}s</span>
