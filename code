              <h3 className="font-semibold text-cyan-400 mb-2 flex items-center gap-2">
                <TrendingDown size={16} />
                Bollinger Squeeze
              </h3>
              <p className="text-sm text-slate-300">Volatility breakout strategy detecting band compression for high-probability directional moves</p>
