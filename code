import React, { useState, useEffect, useRef } from 'react';
import { LineChart, Line, XAxis, YAxis, CartesianGrid, Tooltip, Legend, ResponsiveContainer } from 'recharts';
import { Play, Pause, RotateCcw, TrendingUp, TrendingDown, Activity, AlertTriangle, Brain } from 'lucide-react';

const QuantTradingSimulator = () => {
  const [isRunning, setIsRunning] = useState(false);
  const [gorillaMode, setGorillaMode] = useState(false);
  const [riskTolerance, setRiskTolerance] = useState(50);
  const [priceUpdateSpeed, setPriceUpdateSpeed] = useState(50);
  const [tradingSpeed, setTradingSpeed] = useState(500);
  const [marketData, setMarketData] = useState([]);
  const [trades, setTrades] = useState([]);
  const [portfolio, setPortfolio] = useState({
    cash: 100000,
    positions: {},
    totalValue: 100000,
    history: []
  });
  const [stats, setStats] = useState({
    totalReturn: 0,
    winRate: 0,
    totalTrades: 0
  });

  const timeStep = useRef(0);
  const intervalRef = useRef(null);
  const marketFactor = useRef(1.0);

  const STOCKS = {
    AAPL: { sector: 'tech', beta: 1.25, volatility: 0.018, meanPrice: 226 },
    MSFT: { sector: 'tech', beta: 1.15, volatility: 0.016, meanPrice: 420 },
    NVDA: { sector: 'tech', beta: 1.75, volatility: 0.032, meanPrice: 140 },
    TSLA: { sector: 'auto', beta: 2.00, volatility: 0.038, meanPrice: 360 },
    JPM: { sector: 'finance', beta: 1.15, volatility: 0.020, meanPrice: 235 },
    WMT: { sector: 'retail', beta: 0.60, volatility: 0.013, meanPrice: 95 }
  };

  const generatePrice = (symbol, prevPrice) => {
    const config = STOCKS[symbol];
    const volatility = gorillaMode ? config.volatility * 3 : config.volatility;
    const randomShock = volatility * (Math.random() - 0.5) * 2;
    const marketShock = config.beta * (marketFactor.current - 1) * 0.02;
    const totalChange = prevPrice * (randomShock + marketShock);
    const newPrice = prevPrice + totalChange;
    return Math.max(config.meanPrice * 0.5, Math.min(config.meanPrice * 1.8, newPrice));
  };

  const calculateRSI = (prices) => {
    if (prices.length < 14) return 50;
    let gains = 0;
    let losses = 0;
    for (let i = prices.length - 14; i < prices.length; i++) {
      const change = prices[i] - prices[i - 1];
      if (change > 0) gains += change;
      else losses -= change;
    }
    const avgGain = gains / 14;
    const avgLoss = losses / 14;
    const rs = avgGain / (avgLoss || 0.001);
    return 100 - (100 / (1 + rs));
  };

  const evaluateStrategies = (currentData, historicalData) => {
    if (historicalData.length < 20) return [];
    const signals = [];

    Object.keys(STOCKS).forEach(symbol => {
      const prices = historicalData.map(d => d[symbol]);
      const currentPrice = currentData[symbol];
      const rsi = calculateRSI(prices);
      
      let buyScore = 0;
      let sellScore = 0;

      if (rsi < 30) buyScore += 0.5;
      else if (rsi > 70) sellScore += 0.5;

      const momentum = (prices[prices.length - 1] - prices[prices.length - 10]) / prices[prices.length - 10];
      if (momentum > 0.03) buyScore += 0.3;
      else if (momentum < -0.03) sellScore += 0.3;

      if (buyScore > 0.4) {
        signals.push({ symbol, action: 'BUY', strength: buyScore });
      } else if (sellScore > 0.4) {
        signals.push({ symbol, action: 'SELL', strength: sellScore });
      }
    });

    return signals;
  };

  const executeTrades = (signals, currentPrices, currentPortfolio) => {
    const newPortfolio = { ...currentPortfolio, positions: { ...currentPortfolio.positions } };
    const newTrades = [];

    signals.forEach(signal => {
      const price = currentPrices[signal.symbol];
      const currentShares = newPortfolio.positions[signal.symbol] || 0;
      
      if (signal.action === 'BUY' && newPortfolio.cash > price * 10) {
        const tradeSize = Math.min(newPortfolio.cash * 0.1, 5000);
        const sharesToBuy = Math.floor(tradeSize / price);
        
        if (sharesToBuy > 0) {
          newPortfolio.cash -= sharesToBuy * price;
          newPortfolio.positions[signal.symbol] = currentShares + sharesToBuy;
          newTrades.push({
            symbol: signal.symbol,
            action: 'BUY',
            shares: sharesToBuy,
            price: price.toFixed(2)
          });
        }
      } else if (signal.action === 'SELL' && currentShares > 0) {
        const sharesToSell = Math.floor(currentShares * 0.5);
        if (sharesToSell > 0) {
          newPortfolio.cash += sharesToSell * price;
          newPortfolio.positions[signal.symbol] = currentShares - sharesToSell;
          if (newPortfolio.positions[signal.symbol] === 0) {
            delete newPortfolio.positions[signal.symbol];
          }
          newTrades.push({
            symbol: signal.symbol,
            action: 'SELL',
            shares: sharesToSell,
            price: price.toFixed(2)
          });
        }
      }
    });

    return { newPortfolio, newTrades };
  };

  const simulationStep = () => {
    setMarketData(prevData => {
      const lastData = prevData.length > 0 ? prevData[prevData.length - 1] : null;
      if (!lastData) return prevData;

      marketFactor.current += (Math.random() - 0.5) * 0.01;
      marketFactor.current = Math.max(0.9, Math.min(1.1, marketFactor.current));

      const newData = { time: timeStep.current + 1 };
      Object.keys(STOCKS).forEach(symbol => {
        newData[symbol] = generatePrice(symbol, lastData[symbol]);
      });

      const allData = [...prevData, newData].slice(-200);
      timeStep.current++;

      if (allData.length >= 20 && timeStep.current % 5 === 0) {
        const signals = evaluateStrategies(newData, allData);
        
        setPortfolio(prevPortfolio => {
          const { newPortfolio, newTrades } = executeTrades(signals, newData, prevPortfolio);
          
          let totalValue = newPortfolio.cash;
          Object.keys(newPortfolio.positions).forEach(symbol => {
            totalValue += newPortfolio.positions[symbol] * newData[symbol];
          });
          newPortfolio.totalValue = totalValue;
          newPortfolio.history = [...prevPortfolio.history, totalValue].slice(-200);

          if (newTrades.length > 0) {
            setTrades(prev => [...prev, ...newTrades].slice(-50));
          }

          const totalReturn = ((totalValue - 100000) / 100000) * 100;
          setStats({
            totalReturn: totalReturn.toFixed(2),
            winRate: 0,
            totalTrades: trades.length + newTrades.length
          });

          return newPortfolio;
        });
      } else {
        setPortfolio(prevPortfolio => {
          let totalValue = prevPortfolio.cash;
          Object.keys(prevPortfolio.positions).forEach(symbol => {
            totalValue += prevPortfolio.positions[symbol] * newData[symbol];
          });
          return {
            ...prevPortfolio,
            totalValue,
            history: [...prevPortfolio.history, totalValue].slice(-200)
          };
        });
      }

      return allData;
    });
  };

  const initializeMarket = () => {
    const initial = { time: 0 };
    Object.keys(STOCKS).forEach(symbol => {
      initial[symbol] = STOCKS[symbol].meanPrice;
    });
    setMarketData([initial]);
    setTrades([]);
    setPortfolio({
      cash: 100000,
      positions: {},
      totalValue: 100000,
      history: [100000]
    });
    setStats({ totalReturn: 0, winRate: 0, totalTrades: 0 });
    timeStep.current = 0;
    marketFactor.current = 1.0;
  };

  useEffect(() => {
    initializeMarket();
  }, []);

  useEffect(() => {
    if (intervalRef.current) clearInterval(intervalRef.current);
    if (isRunning) {
      intervalRef.current = setInterval(simulationStep, priceUpdateSpeed);
    }
    return () => {
      if (intervalRef.current) clearInterval(intervalRef.current);
    };
  }, [isRunning, priceUpdateSpeed, gorillaMode]);

  const reset = () => {
    setIsRunning(false);
    initializeMarket();
  };

  return (
    <div className="w-full min-h-screen bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 text-white p-6">
      <div className="max-w-7xl mx-auto space-y-6">
        <div className="flex justify-between items-center">
          <h1 className="text-3xl font-bold bg-gradient-to-r from-blue-400 to-purple-400 bg-clip-text text-transparent">
            AI Trading System
          </h1>
          <div className="flex gap-3">
            <button
              onClick={() => setGorillaMode(!gorillaMode)}
              className={`px-4 py-2 rounded-lg ${gorillaMode ? 'bg-red-600' : 'bg-slate-700'}`}
            >
              {gorillaMode ? '🦍 GORILLA' : 'Normal'}
            </button>
            <button
              onClick={() => setIsRunning(!isRunning)}
              className={`px-6 py-2 rounded-lg ${isRunning ? 'bg-red-600' : 'bg-green-600'}`}
            >
              {isRunning ? <Pause size={20} /> : <Play size={20} />}
            </button>
            <button onClick={reset} className="px-6 py-2 bg-slate-700 rounded-lg">
              <RotateCcw size={20} />
            </button>
          </div>
        </div>

        <div className="bg-slate-800 p-4 rounded-lg">
          <label className="text-sm">Risk Tolerance: {riskTolerance}%</label>
          <input
            type="range"
            min="10"
            max="100"
            value={riskTolerance}
            onChange={(e) => setRiskTolerance(Number(e.target.value))}
            className="w-full"
            disabled={isRunning}
          />
        </div>

        <div className="grid grid-cols-4 gap-4">
          <div className="bg-slate-800 p-4 rounded-lg">
            <div className="text-sm text-slate-400">Portfolio</div>
            <div className="text-2xl font-bold">${portfolio.totalValue.toFixed(0)}</div>
          </div>
          <div className="bg-slate-800 p-4 rounded-lg">
            <div className="text-sm text-slate-400">Return</div>
            <div className={`text-2xl font-bold ${parseFloat(stats.totalReturn) >= 0 ? 'text-green-400' : 'text-red-400'}`}>
              {stats.totalReturn}%
            </div>
          </div>
          <div className="bg-slate-800 p-4 rounded-lg">
            <div className="text-sm text-slate-400">Cash</div>
            <div className="text-2xl font-bold">${portfolio.cash.toFixed(0)}</div>
          </div>
          <div className="bg-slate-800 p-4 rounded-lg">
            <div className="text-sm text-slate-400">Trades</div>
            <div className="text-2xl font-bold">{stats.totalTrades}</div>
          </div>
        </div>

        <div className="bg-slate-800 p-6 rounded-lg">
          <h2 className="text-xl font-semibold mb-4">Market Prices</h2>
          <ResponsiveContainer width="100%" height={300}>
            <LineChart data={marketData.slice(-60)}>
              <CartesianGrid strokeDasharray="3 3" stroke="#334155" />
              <XAxis dataKey="time" stroke="#94a3b8" />
              <YAxis stroke="#94a3b8" />
              <Tooltip contentStyle={{ backgroundColor: '#1e293b', border: 'none' }} />
              <Legend />
              <Line type="monotone" dataKey="AAPL" stroke="#3b82f6" dot={false} strokeWidth={2} />
              <Line type="monotone" dataKey="MSFT" stroke="#10b981" dot={false} strokeWidth={2} />
              <Line type="monotone" dataKey="NVDA" stroke="#f59e0b" dot={false} strokeWidth={2} />
              <Line type="monotone" dataKey="TSLA" stroke="#ef4444" dot={false} strokeWidth={2} />
            </LineChart>
          </ResponsiveContainer>
        </div>

        <div className="grid grid-cols-2 gap-4">
          <div className="bg-slate-800 p-6 rounded-lg">
            <h2 className="text-xl font-semibold mb-4">Positions</h2>
            <div className="space-y-2">
              {Object.keys(STOCKS).map(symbol => {
                const shares = portfolio.positions[symbol] || 0;
                const price = marketData.length > 0 ? marketData[marketData.length - 1][symbol] : 0;
                return (
                  <div key={symbol} className={`p-3 rounded-lg ${shares > 0 ? 'bg-slate-700' : 'bg-slate-700/30'}`}>
                    <div className="flex justify-between">
                      <div>
                        <div className="font-bold">{symbol}</div>
                        <div className="text-sm text-slate-400">
                          {shares > 0 ? `${shares} @ $${price.toFixed(2)}` : 'No position'}
                        </div>
                      </div>
                      {shares > 0 && (
                        <div className="text-right">
                          <div className="font-bold">${(shares * price).toFixed(2)}</div>
                        </div>
                      )}
                    </div>
                  </div>
                );
              })}
            </div>
          </div>

          <div className="bg-slate-800 p-6 rounded-lg">
            <h2 className="text-xl font-semibold mb-4">Recent Trades</h2>
            <div className="space-y-2 max-h-64 overflow-y-auto">
              {trades.slice().reverse().map((trade, idx) => (
                <div key={idx} className="p-3 bg-slate-700 rounded-lg text-sm">
                  <div className="flex justify-between">
                    <div className="flex items-center gap-2">
                      {trade.action === 'BUY' ? (
                        <TrendingUp className="text-green-400" size={16} />
                      ) : (
                        <TrendingDown className="text-red-400" size={16} />
                      )}
                      <span className="font-bold">{trade.symbol}</span>
                    </div>
                    <div className="text-right">
                      <div className={trade.action === 'BUY' ? 'text-green-400' : 'text-red-400'}>
                        {trade.action} {trade.shares}
                      </div>
                      <div className="text-xs text-slate-400">@${trade.price}</div>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  );
};

export default QuantTradingSimulator;
