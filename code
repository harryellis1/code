                      <div className="text-xs text-slate-400">{trade.strategies}</div>
                    </div>
                  </div>
                  <div className="text-right">
                    <div className={`font-semibold ${trade.action === 'BUY' ? 'text-green-400' : 'text-red-400'}`}>
