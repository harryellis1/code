        <div className="bg-slate-800/70 backdrop-blur p-6 rounded-xl shadow-xl border border-slate-700">
          <h2 className="text-xl font-semibold mb-3">Advanced Trading Models</h2>
          <div className="grid grid-cols-3 gap-4">
            <div className="bg-gradient-to-br from-blue-900/30 to-blue-800/20 p-4 rounded-lg border border-blue-700/30">
              <h3 className="font-semibold text-blue-400 mb-2 flex items-center gap-2">
                <Zap size={16} />
                Multi-Factor Model
              </h3>
              <p className="text-sm text-slate-300">Fama-French inspired model analyzing market, size, value, momentum, quality, and volatility factors</p>
            </div>
            <div className="bg-gradient-to-br from-purple-900/30 to-purple-800/20 p-4 rounded-lg border border-purple-700/30">
              <h3 className="font-semibold text-purple-400 mb-2 flex items-center gap-2">
                <Activity size={16} />
                Statistical Arbitrage
              </h3>
              <p className="text-sm text-slate-300">Pairs trading using cointegration analysis with z-score thresholds to exploit mean-reverting spreads</p>
            </div>
            <div className="bg-gradient-to-br from-green-900/30 to-green-800/20 p-4 rounded-lg border border-green-700/30">
              <h3 className="font-semibold text-green-400 mb-2 flex items-center gap-2">
                <TrendingUp size={16} />
