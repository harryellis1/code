            </ResponsiveContainer>
          </div>

          <div className="bg-slate-800/70 backdrop-blur p-6 rounded-xl shadow-xl border border-slate-700">
            <h2 className="text-xl font-semibold mb-4 flex items-center gap-2">
              <Activity className="text-purple-400" size={24} />
              Factor Exposures
            </h2>
            <ResponsiveContainer width="100%" height={350}>
              <BarChart data={factorData}>
                <CartesianGrid strokeDasharray="3 3" stroke="#334155" />
                <XAxis dataKey="name" stroke="#94a3b8" angle={-45} textAnchor="end" height={80} />
                <YAxis stroke="#94a3b8" />
                <Tooltip 
                  contentStyle={{ backgroundColor: '#1e293b', border: 'none', borderRadius: '8px' }}
                  formatter={(value) => `${value.toFixed(2)}%`}
                />
                <Bar dataKey="value" fill="#8b5cf6" />
              </BarChart>
            </ResponsiveContainer>
          </div>
        </div>

        <div className="bg-slate-800/70 backdrop-blur p-6 rounded-xl shadow-xl border border-slate-700">
          <h2 className="text-xl font-semibold mb-4 flex items-center gap-2">
            <Activity className="text-blue-400" size={24} />
            Portfolio Value Over Time
          </h2>
          <ResponsiveContainer width="100%" height={300}>
            <LineChart data={portfolio.history.map((val, idx) => ({ time: idx, value: val }))}>
              <CartesianGrid strokeDasharray="3 3" stroke="#334155" />
              <XAxis dataKey="time" stroke="#94a3b8" />
              <YAxis stroke="#94a3b8" domain={['auto', 'auto']} />
              <Tooltip 
                contentStyle={{ backgroundColor: '#1e293b', border: 'none', borderRadius: '8px' }}
                formatter={(value) => `${value.toLocaleString(undefined, {maximumFractionDigits: 2})}`}
              />
              <Line type="monotone" dataKey="value" stroke="#8b5cf6" dot={false} strokeWidth={3} />
            </LineChart>
          </ResponsiveContainer>
        </div>

        <div className="grid grid-cols-2 gap-4">
          <div className="bg-slate-800/70 backdrop-blur p-6 rounded-xl shadow-xl border border-slate-700">
            <h2 className="text-xl font-semibold mb-4">Current Positions</h2>
            <div className="space-y-2 max-h-96 overflow-y-auto">
              {Object.keys(STOCKS).map(symbol => {
                const shares = portfolio.positions[symbol] || 0;
                const price = marketData.length > 0 ? marketData[marketData.length - 1][symbol] : 0;
                const value = shares * price;
                const percentOfPortfolio = portfolio.totalValue > 0 ? (value / portfolio.totalValue) * 100 : 0;
                
                return (
                  <div key={symbol} className={`flex justify-between items-center p-4 rounded-lg transition-all ${shares > 0 ? 'bg-gradient-to-r from-slate-700/80 to-slate-600/50' : 'bg-slate-700/30'}`}>
                    <div>
                      <div className="font-bold text-lg flex items-center gap-2">
                        {symbol}
                        <span className="text-xs bg-slate-600 px-2 py-1 rounded">{STOCKS[symbol].sector}</span>
                      </div>
                      <div className="text-sm text-slate-400">
                        {shares > 0 ? `${shares} shares @ ${price.toFixed(2)}` : 'No position'}
                      </div>
                    </div>
                    {shares > 0 && (
                      <div className="text-right">
                        <div className="font-bold text-lg">${value.toFixed(2)}</div>
                        <div className="text-sm text-slate-400">{percentOfPortfolio.toFixed(1)}%</div>
                      </div>
                    )}
                  </div>
                );
              })}
            </div>
          </div>

          <div className="bg-slate-800/70 backdrop-blur p-6 rounded-xl shadow-xl border border-slate-700">
            <h2 className="text-xl font-semibold mb-4">Recent Trades ({stats.totalTrades} total)</h2>
            <div className="space-y-2 max-h-96 overflow-y-auto">
              {trades.slice().reverse().slice(0, 20).map((trade, idx) => (
                <div key={idx} className="flex justify-between items-center p-3 bg-slate-700/50 rounded-lg text-sm hover:bg-slate-700 transition-all">
                  <div className="flex items-center gap-3">
                    {trade.action === 'BUY' ? (
                      <TrendingUp className="text-green-400 flex-shrink-0" size={18} />
