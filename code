          <div className="flex gap-3">
            <button
              onClick={toggleDataMode}
              className={`flex items-center gap-2 px-4 py-3 rounded-lg transition shadow-lg ${
                useRealData 
                  ? 'bg-green-600 hover:bg-green-700' 
                  : 'bg-blue-600 hover:bg-blue-700'
              }`}
