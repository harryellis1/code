                    ? 'Prices update every 5 seconds • Trading executes every 15 seconds' 
                    : `Prices update every ${priceUpdateSpeed}ms • Trading executes every ${tradingSpeed}ms`}
                </div>
              </div>
              <div className={`px-4 py-2 rounded-full text-sm font-semibold ${
                connectionStatus === 'connected' ? 'bg-green-900/50 text-green-300' :
                connectionStatus === 'simulated' ? 'bg-blue-900/50 text-blue-300' :
                connectionStatus === 'connecting' ? 'bg-yellow-900/50 text-yellow-300' :
                'bg-red-900/50 text-red-300'
