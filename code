                <Zap size={16} />
                Machine Learning
              </h3>
              <p className="text-sm text-slate-300">Gradient boosting-inspired prediction using engineered features: SMA ratios, momentum, volatility</p>
            </div>
            <div className="bg-gradient-to-br from-red-900/30 to-red-800/20 p-4 rounded-lg border border-red-700/30">
              <h3 className="font-semibold text-red-400 mb-2 flex items-center gap-2">
                <Activity size={16} />
                Mean Reversion (RSI)
              </h3>
              <p className="text-sm text-slate-300">RSI-based contrarian strategy targeting oversold and overbought conditions with dynamic sizing</p>
