import React, { useState, useEffect, useRef, useCallback } from 'react';
import { LineChart, Line, XAxis, YAxis, CartesianGrid, Tooltip, Legend, ResponsiveContainer } from 'recharts';
import { Play, Pause, RotateCcw, TrendingUp, TrendingDown } from 'lucide-react';

const QuantTradingSimulator = () => {
  const [isRunning, setIsRunning] = useState(false);
  const [marketMode, setMarketMode] = useState('normal');
  const [riskTolerance, setRiskTolerance] = useState(50);
  const [tradingFrequency, setTradingFrequency] = useState(100);
  const [investmentPercent, setInvestmentPercent] = useState(10);
  const [reserveAmount, setReserveAmount] = useState(10000);
  const [stopLossPercent, setStopLossPercent] = useState(5);
  const [startingCapital, setStartingCapital] = useState(100000);
  const [showCapitalModal, setShowCapitalModal] = useState(false);
  const [showProfileModal, setShowProfileModal] = useState(false);
  const [watchlist, setWatchlist] = useState([]);
  const [showWatchlistModal, setShowWatchlistModal] = useState(false);
  const [marketRegime, setMarketRegime] = useState('Normal');
  const [marketData, setMarketData] = useState([]);
  const [trades, setTrades] = useState([]);
  const [portfolio, setPortfolio] = useState({
    cash: 100000,
    positions: {},
    shorts: {},
    entryPrices: {},
    totalValue: 100000,
    history: [],
    peakValue: 100000
  });
  const [stats, setStats] = useState({
    totalReturn: 0,
    winRate: 0,
    totalTrades: 0,
    marketCondition: 'Normal',
    activeModel: 'Ensemble',
    modelWeights: {},
    sharpeRatio: 0
  });

  const timeStep = useRef(0);
  const intervalRef = useRef(null);
  const tradeIntervalRef = useRef(null);
  const marketFactor = useRef(1.0);
  const marketTrend = useRef(0);
  const marketUpdateSpeed = 50;

  const STOCKS = {
    AAPL: { sector: 'tech', beta: 1.25, volatility: 0.018, meanPrice: 230, color: '#3b82f6', name: 'Apple Inc.' },
    MSFT: { sector: 'tech', beta: 1.15, volatility: 0.016, meanPrice: 500, color: '#10b981', name: 'Microsoft Corp.' },
    NVDA: { sector: 'tech', beta: 1.75, volatility: 0.032, meanPrice: 185, color: '#f59e0b', name: 'NVIDIA Corp.' },
    TSLA: { sector: 'auto', beta: 2.00, volatility: 0.038, meanPrice: 430, color: '#ef4444', name: 'Tesla Inc.' },
    GOOGL: { sector: 'tech', beta: 1.10, volatility: 0.019, meanPrice: 195, color: '#8b5cf6', name: 'Alphabet Inc.' },
    AMZN: { sector: 'retail', beta: 1.30, volatility: 0.022, meanPrice: 230, color: '#ec4899', name: 'Amazon.com Inc.' },
    META: { sector: 'tech', beta: 1.40, volatility: 0.025, meanPrice: 640, color: '#06b6d4', name: 'Meta Platforms' },
    JPM: { sector: 'finance', beta: 1.15, volatility: 0.020, meanPrice: 260, color: '#84cc16', name: 'JPMorgan Chase' },
    BAC: { sector: 'finance', beta: 1.20, volatility: 0.021, meanPrice: 48, color: '#f97316', name: 'Bank of America' },
    WMT: { sector: 'retail', beta: 0.60, volatility: 0.013, meanPrice: 105, color: '#14b8a6', name: 'Walmart Inc.' },
    JNJ: { sector: 'healthcare', beta: 0.70, volatility: 0.012, meanPrice: 155, color: '#a855f7', name: 'Johnson & Johnson' },
    PFE: { sector: 'healthcare', beta: 0.65, volatility: 0.018, meanPrice: 26, color: '#f43f5e', name: 'Pfizer Inc.' },
    XOM: { sector: 'energy', beta: 1.05, volatility: 0.024, meanPrice: 120, color: '#eab308', name: 'Exxon Mobil' },
    CVX: { sector: 'energy', beta: 1.00, volatility: 0.023, meanPrice: 165, color: '#22c55e', name: 'Chevron Corp.' },
    DIS: { sector: 'media', beta: 1.20, volatility: 0.021, meanPrice: 115, color: '#6366f1', name: 'Walt Disney Co.' },
    NFLX: { sector: 'media', beta: 1.50, volatility: 0.028, meanPrice: 980, color: '#dc2626', name: 'Netflix Inc.' },
    BA: { sector: 'aerospace', beta: 1.60, volatility: 0.030, meanPrice: 180, color: '#0ea5e9', name: 'Boeing Co.' },
    AMD: { sector: 'tech', beta: 1.80, volatility: 0.035, meanPrice: 145, color: '#d946ef', name: 'AMD Inc.' },
    INTC: { sector: 'tech', beta: 1.10, volatility: 0.022, meanPrice: 22, color: '#78716c', name: 'Intel Corp.' },
    KO: { sector: 'consumer', beta: 0.55, volatility: 0.011, meanPrice: 68, color: '#16a34a', name: 'Coca-Cola Co.' }
  };

  const generatePrice = useCallback((symbol, prevPrice, mode) => {
    const config = STOCKS[symbol];
    let volatilityMultiplier = 1;
    let trendBias = 0;

    if (mode === 'livemarket') {
      volatilityMultiplier = 0.8;
    } else if (mode === 'gorilla') {
      volatilityMultiplier = 3;
    } else if (mode === 'announcement') {
      volatilityMultiplier = 2;
      trendBias = marketTrend.current * 0.003;
    } else if (mode === 'crash') {
      volatilityMultiplier = 4;
      trendBias = -0.008;
    }

    const volatility = config.volatility * volatilityMultiplier;
    const randomShock = volatility * (Math.random() - 0.5) * 2;
    const marketShock = config.beta * (marketFactor.current - 1) * 0.02;
    const totalChange = prevPrice * (randomShock + marketShock + trendBias);
    const newPrice = prevPrice + totalChange;
    return Math.max(config.meanPrice * 0.3, Math.min(config.meanPrice * 2.0, newPrice));
  }, []);

  const calculateRSI = useCallback((prices) => {
    if (prices.length < 14) return 50;
    let gains = 0, losses = 0;
    const len = prices.length;
    for (let i = len - 14; i < len; i++) {
      const change = prices[i] - prices[i - 1];
      if (change > 0) gains += change;
      else losses -= change;
    }
    const avgGain = gains / 14;
    const avgLoss = losses / 14;
    return avgLoss === 0 ? 100 : 100 - (100 / (1 + avgGain / avgLoss));
  }, []);

  const detectMarketCondition = useCallback((historicalData) => {
    const len = historicalData.length;
    if (len < 30) return { condition: 'Normal', regime: 'Normal', confidence: 50 };
    
    const recentPrices = historicalData.slice(-30);
    let totalChange = 0, volatilitySum = 0;
    const symbols = Object.keys(STOCKS);
    const symLen = symbols.length;
    
    for (let s = 0; s < symLen; s++) {
      const symbol = symbols[s];
      const prices = new Array(30);
      for (let i = 0; i < 30; i++) {
        prices[i] = recentPrices[i][symbol];
      }
      
      const change = (prices[29] - prices[0]) / prices[0];
      totalChange += change;
      
      let varianceSum = 0;
      for (let i = 1; i < 30; i++) {
        const ret = (prices[i] - prices[i-1]) / prices[i-1];
        varianceSum += ret * ret;
      }
      volatilitySum += Math.sqrt(varianceSum / 30);
    }
    
    const avgChange = totalChange / symLen;
    const avgVolatility = volatilitySum / symLen;
    
    let condition = 'Normal', regime = 'Normal';
    
    if (avgChange < -0.10 && avgVolatility > 0.025) {
      condition = 'Severe Crash';
      regime = 'Crisis';
    } else if (avgChange < -0.05 && avgVolatility > 0.020) {
      condition = 'Market Crash';
      regime = 'Bear Market';
    } else if (avgVolatility > 0.030) {
      condition = 'High Volatility';
      regime = 'Panic Selling';
    } else if (Math.abs(avgChange) > 0.08) {
      condition = 'Strong Trend';
      regime = avgChange > 0 ? 'Bull Market' : 'Distribution';
    } else if (avgVolatility > 0.018) {
      condition = 'Elevated Volatility';
      regime = 'Uncertain';
    }
    
    return { condition, regime, avgVolatility };
  }, []);

  const initializeMarket = useCallback(() => {
    const initial = { time: 0 };
    Object.keys(STOCKS).forEach(symbol => {
      initial[symbol] = STOCKS[symbol].meanPrice;
    });
    setMarketData([initial]);
    setTrades([]);
    setPortfolio({
      cash: startingCapital,
      positions: {},
      shorts: {},
      entryPrices: {},
      totalValue: startingCapital,
      history: [startingCapital],
      peakValue: startingCapital
    });
    setStats({ totalReturn: 0, winRate: 0, totalTrades: 0, marketCondition: 'Normal', activeModel: 'Ensemble', modelWeights: {}, sharpeRatio: 0 });
    timeStep.current = 0;
    marketFactor.current = 1.0;
    marketTrend.current = 0;
  }, [startingCapital]);

  useEffect(() => {
    initializeMarket();
  }, [initializeMarket]);

  useEffect(() => {
    if (intervalRef.current) clearInterval(intervalRef.current);
    if (tradeIntervalRef.current) clearInterval(tradeIntervalRef.current);
    
    if (isRunning) {
      intervalRef.current = setInterval(() => {
        setMarketData(prevData => {
          const lastData = prevData.length > 0 ? prevData[prevData.length - 1] : null;
          if (!lastData) return prevData;

          if (marketMode === 'announcement') {
            marketTrend.current = Math.random() > 0.5 ? 1 : -1;
            marketFactor.current += marketTrend.current * 0.02;
          } else if (marketMode === 'crash') {
            marketFactor.current -= 0.015;
          } else {
            marketFactor.current += (Math.random() - 0.5) * 0.01;
          }
          
          marketFactor.current = Math.max(0.7, Math.min(1.3, marketFactor.current));

          const newData = { time: timeStep.current + 1 };
          const symbolsToUpdate = marketMode === 'livemarket' && watchlist.length > 0 
            ? watchlist 
            : Object.keys(STOCKS);
          
          symbolsToUpdate.forEach(symbol => {
            if (STOCKS[symbol]) {
              newData[symbol] = generatePrice(symbol, lastData[symbol], marketMode);
            }
          });

          const allData = [...prevData, newData].slice(-200);
          timeStep.current++;

          setPortfolio(prevPortfolio => {
            let totalValue = prevPortfolio.cash;
            const posKeys = Object.keys(prevPortfolio.positions);
            const posLen = posKeys.length;
            for (let i = 0; i < posLen; i++) {
              const sym = posKeys[i];
              if (newData[sym]) totalValue += prevPortfolio.positions[sym] * newData[sym];
            }
            const shortKeys = Object.keys(prevPortfolio.shorts);
            const shortLen = shortKeys.length;
            for (let i = 0; i < shortLen; i++) {
              const sym = shortKeys[i];
              if (newData[sym]) totalValue -= prevPortfolio.shorts[sym] * newData[sym];
            }
            return {
              ...prevPortfolio,
              totalValue,
              history: [...prevPortfolio.history, totalValue].slice(-200)
            };
          });

          return allData;
        });
      }, marketUpdateSpeed);
      
      tradeIntervalRef.current = setInterval(() => {
        setMarketData(prevData => {
          if (prevData.length < 20) return prevData;
          
          const newData = prevData[prevData.length - 1];
          const marketInfo = detectMarketCondition(prevData);
          
          setMarketRegime(marketInfo.regime);
          
          setPortfolio(prevPortfolio => {
            const signals = [];
            const activeSymbols = marketMode === 'livemarket' && watchlist.length > 0 ? watchlist : Object.keys(STOCKS);
            
            activeSymbols.forEach(symbol => {
              if (!STOCKS[symbol] || !newData[symbol]) return;
              const prices = prevData.map(d => d[symbol]).filter(p => p !== undefined);
              const len = prices.length;
              if (len < 20) return;
              
              const currentPrice = prices[len - 1];
              const rsi = calculateRSI(prices);
              
              let sum5 = 0, sum10 = 0, sum20 = 0;
              for (let i = len - 5; i < len; i++) sum5 += prices[i];
              for (let i = len - 10; i < len; i++) sum10 += prices[i];
              for (let i = len - 20; i < len; i++) sum20 += prices[i];
              const ma5 = sum5 / 5;
              const ma10 = sum10 / 10;
              const ma20 = sum20 / 20;
              
              const momentum5 = (currentPrice - prices[len - 5]) / prices[len - 5];
              const momentum10 = (currentPrice - prices[len - 10]) / prices[len - 10];
              
              let varSum = 0;
              for (let i = len - 20; i < len - 1; i++) {
                const ret = (prices[i + 1] - prices[i]) / prices[i];
                varSum += ret * ret;
              }
              const volatility = Math.sqrt(varSum / 19);
              
              const slice30 = prices.slice(-30);
              const mean = slice30.reduce((a, b) => a + b, 0) / slice30.length;
              const variance = slice30.reduce((s, p) => s + (p - mean) ** 2, 0) / slice30.length;
              const std = Math.sqrt(variance);
              const zScore = (currentPrice - mean) / std;
              
              const trendUp = ma5 > ma10 && ma10 > ma20;
              const trendDown = ma5 < ma10 && ma10 < ma20;
              
              let decision = 'HOLD';
              let confidence = 50;
              let reason = '';
              
              if (rsi < 20 && momentum5 > 0.005 && marketInfo.regime !== 'Crisis') {
                decision = 'BUY';
                confidence = 95;
                reason = 'Deep oversold + reversal';
              }
              else if (rsi < 25 && momentum5 > 0 && volatility < 0.02 && marketInfo.regime !== 'Crisis') {
                decision = 'BUY';
                confidence = 92;
                reason = 'Oversold low-vol bounce';
              }
              else if (trendUp && rsi < 55 && momentum5 > 0.015 && momentum10 > 0.025) {
                decision = 'BUY';
                confidence = 90;
                reason = 'Accelerating uptrend';
              }
              else if (zScore < -2.5 && rsi < 35 && momentum5 > -0.01) {
                decision = 'BUY';
                confidence = 88;
                reason = 'Extreme mean reversion';
              }
              else if (ma5 > ma20 && rsi > 35 && rsi < 60 && momentum5 > 0.005) {
                decision = 'BUY';
                confidence = 82;
                reason = 'Strong trend following';
              }
              else if (currentPrice < ma20 * 0.97 && rsi < 45 && momentum10 > 0) {
                decision = 'BUY';
                confidence = 78;
                reason = 'Pullback buy';
              }
              
              else if (marketInfo.regime === 'Crisis' && momentum5 < -0.01) {
                decision = 'SHORT';
                confidence = 96;
                reason = 'Crisis + momentum';
              }
              else if (marketInfo.regime === 'Panic Selling' && rsi > 50) {
                decision = 'SHORT';
                confidence = 94;
                reason = 'Panic selling wave';
              }
              else if (rsi > 85 && momentum5 < -0.005) {
                decision = 'SHORT';
                confidence = 92;
                reason = 'Extreme overbought reversal';
              }
              else if (trendDown && rsi > 45 && momentum5 < -0.015 && momentum10 < -0.025) {
                decision = 'SHORT';
                confidence = 90;
                reason = 'Accelerating downtrend';
              }
              else if (zScore > 3 && rsi > 70) {
                decision = 'SHORT';
                confidence = 88;
                reason = 'Extreme deviation short';
              }
              else if (ma5 < ma20 && rsi > 50 && momentum5 < -0.01) {
                decision = 'SHORT';
                confidence = 85;
                reason = 'Downtrend momentum';
              }
              else if (currentPrice > ma20 * 1.05 && rsi > 65) {
                decision = 'SHORT';
                confidence = 80;
                reason = 'Extended short';
              }
              
              const hasLong = prevPortfolio.positions[symbol] > 0;
              const hasShort = prevPortfolio.shorts[symbol] > 0;
              
              if (hasLong) {
                const entryPrice = prevPortfolio.entryPrices[symbol] || currentPrice;
                const pnl = (currentPrice - entryPrice) / entryPrice;
                
                if (pnl > 0.10) {
                  decision = 'SELL';
                  confidence = 98;
                  reason = 'Take profit 10%+';
                }
                else if (pnl > 0.07 && (rsi > 70 || momentum5 < 0)) {
                  decision = 'SELL';
                  confidence = 92;
                  reason = 'Take profit 7%+ weakening';
                }
                else if (pnl > 0.04 && rsi > 75) {
                  decision = 'SELL';
                  confidence = 88;
                  reason = 'Take profit overbought';
                }
                else if (pnl > 0.03 && momentum5 < -0.015) {
                  decision = 'SELL';
                  confidence = 85;
                  reason = 'Lock profit momentum shift';
                }
                else if (pnl < -stopLossPercent / 100) {
                  decision = 'SELL';
                  confidence = 98;
                  reason = 'Stop loss triggered';
                }
                else if (pnl < -(stopLossPercent / 100) * 0.7 && momentum5 < -0.02) {
                  decision = 'SELL';
                  confidence = 90;
                  reason = 'Pre-emptive stop';
                }
                else if (rsi > 78 && momentum5 < -0.01) {
                  decision = 'SELL';
                  confidence = 85;
                  reason = 'Reversal exit';
                }
                else if (ma5 < ma10 && pnl > 0) {
                  decision = 'SELL';
                  confidence = 80;
                  reason = 'Trend break profit';
                }
              }
              
              if (hasShort) {
                const entryPrice = prevPortfolio.entryPrices[symbol] || currentPrice;
                const pnl = (entryPrice - currentPrice) / entryPrice;
                
                if (pnl > 0.08) {
                  decision = 'COVER';
                  confidence = 98;
                  reason = 'Cover 8%+ profit';
                }
                else if (pnl > 0.05 && (rsi < 35 || momentum5 > 0)) {
                  decision = 'COVER';
                  confidence = 92;
                  reason = 'Cover 5%+ reversal risk';
                }
                else if (pnl > 0.03 && rsi < 30) {
                  decision = 'COVER';
                  confidence = 88;
                  reason = 'Cover oversold bounce risk';
                }
                else if (pnl < -stopLossPercent / 100) {
                  decision = 'COVER';
                  confidence = 98;
                  reason = 'Cover stop loss';
                }
                else if (pnl < -(stopLossPercent / 100) * 0.7 && momentum5 > 0.015) {
                  decision = 'COVER';
                  confidence = 90;
                  reason = 'Cover pre-emptive';
                }
                else if (rsi < 25 && momentum5 > 0.01) {
                  decision = 'COVER';
                  confidence = 85;
                  reason = 'Cover bounce imminent';
                }
                else if (ma5 > ma10 && pnl > 0) {
                  decision = 'COVER';
                  confidence = 80;
                  reason = 'Cover trend reversal';
                }
              }
              
              if (decision !== 'HOLD' && confidence >= riskTolerance) {
                signals.push({ symbol, action: decision, successRate: confidence, reason });
              }
            });
            
            const newPortfolio = { 
              ...prevPortfolio, 
              positions: { ...prevPortfolio.positions }, 
              shorts: { ...prevPortfolio.shorts }, 
              entryPrices: { ...prevPortfolio.entryPrices } 
            };
            const newTrades = [];
            const availableCash = Math.max(0, newPortfolio.cash - reserveAmount);
            
            const signalsLen = signals.length;
            for (let i = 0; i < signalsLen; i++) {
              const signal = signals[i];
              const price = newData[signal.symbol];
              if (!price) continue;
              
              if (signal.action === 'BUY' && availableCash > price * 5) {
                const baseSize = Math.min(availableCash * (investmentPercent / 100), availableCash * 0.30);
                const confidenceMultiplier = signal.successRate > 95 ? 2.0 : signal.successRate > 90 ? 1.8 : signal.successRate > 85 ? 1.5 : 1.2;
                const positionSize = baseSize * confidenceMultiplier;
                const sharesToBuy = Math.floor(positionSize / price);
                if (sharesToBuy > 0 && newPortfolio.cash >= sharesToBuy * price + reserveAmount) {
                  newPortfolio.cash -= sharesToBuy * price;
                  newPortfolio.positions[signal.symbol] = (newPortfolio.positions[signal.symbol] || 0) + sharesToBuy;
                  newPortfolio.entryPrices[signal.symbol] = price;
                  newTrades.push({ symbol: signal.symbol, action: 'BUY', shares: sharesToBuy, price: price.toFixed(2), successRate: signal.successRate, reason: signal.reason });
                }
              } 
              else if (signal.action === 'SHORT' && availableCash > price * 5) {
                const baseSize = Math.min(availableCash * (investmentPercent / 100), availableCash * 0.25);
                const confidenceMultiplier = signal.successRate > 95 ? 1.8 : signal.successRate > 90 ? 1.6 : signal.successRate > 85 ? 1.4 : 1.2;
                const positionSize = baseSize * confidenceMultiplier;
                const sharesToShort = Math.floor(positionSize / price);
                if (sharesToShort > 0) {
                  newPortfolio.cash += sharesToShort * price;
                  newPortfolio.shorts[signal.symbol] = (newPortfolio.shorts[signal.symbol] || 0) + sharesToShort;
                  newPortfolio.entryPrices[signal.symbol] = price;
                  newTrades.push({ symbol: signal.symbol, action: 'SHORT', shares: sharesToShort, price: price.toFixed(2), successRate: signal.successRate, reason: signal.reason });
                }
              }
              else if (signal.action === 'SELL' && newPortfolio.positions[signal.symbol] > 0) {
                const shares = newPortfolio.positions[signal.symbol];
                newPortfolio.cash += shares * price;
                delete newPortfolio.positions[signal.symbol];
                delete newPortfolio.entryPrices[signal.symbol];
                newTrades.push({ symbol: signal.symbol, action: 'SELL', shares, price: price.toFixed(2), successRate: signal.successRate, reason: signal.reason });
              }
              else if (signal.action === 'COVER' && newPortfolio.shorts[signal.symbol] > 0) {
                const shares = newPortfolio.shorts[signal.symbol];
                newPortfolio.cash -= shares * price;
                delete newPortfolio.shorts[signal.symbol];
                delete newPortfolio.entryPrices[signal.symbol];
                newTrades.push({ symbol: signal.symbol, action: 'COVER', shares, price: price.toFixed(2), successRate: signal.successRate, reason: signal.reason });
              }
            }
            
            let totalValue = newPortfolio.cash;
            const posKeys = Object.keys(newPortfolio.positions);
            const posLen = posKeys.length;
            for (let i = 0; i < posLen; i++) {
              const sym = posKeys[i];
              if (newData[sym]) totalValue += newPortfolio.positions[sym] * newData[sym];
            }
            const shortKeys = Object.keys(newPortfolio.shorts);
            const shortLen = shortKeys.length;
            for (let i = 0; i < shortLen; i++) {
              const sym = shortKeys[i];
              if (newData[sym]) totalValue -= newPortfolio.shorts[sym] * newData[sym];
            }
            
            const peakValue = Math.max(prevPortfolio.peakValue || startingCapital, totalValue);
            
            newPortfolio.totalValue = totalValue;
            newPortfolio.peakValue = peakValue;
            newPortfolio.history = [...prevPortfolio.history.slice(-199), totalValue];

            if (newTrades.length > 0) {
              setTrades(prev => [...prev, ...newTrades].slice(-50));
            }

            const totalReturn = ((totalValue - startingCapital) / startingCapital) * 100;
            const drawdown = ((peakValue - totalValue) / peakValue) * 100;
            
            setStats({
              totalReturn: totalReturn.toFixed(2),
              winRate: 0,
              totalTrades: trades.length + newTrades.length,
              marketCondition: marketInfo.regime,
              activeModel: 'Advanced Multi-Strategy',
              modelWeights: {},
              sharpeRatio: drawdown.toFixed(2)
            });

            return newPortfolio;
          });

          return prevData;
        });
      }, tradingFrequency);
    }
    
    return () => {
      if (intervalRef.current) clearInterval(intervalRef.current);
      if (tradeIntervalRef.current) clearInterval(tradeIntervalRef.current);
    };
  }, [isRunning, marketMode, tradingFrequency, watchlist, generatePrice, calculateRSI, detectMarketCondition, riskTolerance, investmentPercent, trades.length, stopLossPercent, reserveAmount, startingCapital]);

  const reset = () => {
    setIsRunning(false);
    initializeMarket();
  };

  const toggleWatchlist = (symbol) => {
    setWatchlist(prev => {
      if (prev.includes(symbol)) {
        return prev.filter(s => s !== symbol);
      } else {
        return [...prev, symbol];
      }
    });
  };

  const applyProfile = (profile) => {
    switch(profile) {
      case 'conservative':
        setRiskTolerance(60);
        setTradingFrequency(500);
        setInvestmentPercent(5);
        setReserveAmount(30000);
        setStopLossPercent(7);
        break;
      case 'balanced':
        setRiskTolerance(65);
        setTradingFrequency(75);
        setInvestmentPercent(12);
        setReserveAmount(12000);
        setStopLossPercent(4);
        break;
      case 'aggressive':
        setRiskTolerance(75);
        setTradingFrequency(20);
        setInvestmentPercent(25);
        setReserveAmount(3000);
        setStopLossPercent(3);
        break;
      case 'hft':
        setRiskTolerance(85);
        setTradingFrequency(1);
        setInvestmentPercent(15);
        setReserveAmount(10000);
        setStopLossPercent(3);
        break;
      case 'daytrader':
        setRiskTolerance(75);
        setTradingFrequency(50);
        setInvestmentPercent(12);
        setReserveAmount(10000);
        setStopLossPercent(4);
        break;
      case 'scalper':
        setRiskTolerance(90);
        setTradingFrequency(5);
        setInvestmentPercent(25);
        setReserveAmount(5000);
        setStopLossPercent(2);
        break;
      case 'swingtrader':
        setRiskTolerance(65);
        setTradingFrequency(1000);
        setInvestmentPercent(15);
        setReserveAmount(20000);
        setStopLossPercent(8);
        break;
      case 'whale':
