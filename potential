const MultiMarketTradingSimulator = () => {
  const [isRunning, setIsRunning] = useState(false);
  const [marketMode, setMarketMode] = useState('normal');
  const [riskTolerance, setRiskTolerance] = useState(50);
  const [tradingFrequency, setTradingFrequency] = useState(1);
  const [investmentPercent, setInvestmentPercent] = useState(15);
  const [reserveAmount, setReserveAmount] = useState(10000);
  const [stopLossPercent, setStopLossPercent] = useState(5);
  const [takeProfitPercent, setTakeProfitPercent] = useState(15);
  const [autoMode, setAutoMode] = useState(true);
  const [startingCapital, setStartingCapital] = useState(100000);
  const [showCapitalModal, setShowCapitalModal] = useState(false);
  const [showProfileModal, setShowProfileModal] = useState(false);
  const [expandedSection, setExpandedSection] = useState('portfolio');
  const [lastVote, setLastVote] = useState({});
  const [voteTime, setVoteTime] = useState(0);

  const [markets, setMarkets] = useState({
    stocks: { data: [], portfolio: null, stats: null, bots: null },
    crypto: { data: [], portfolio: null, stats: null, bots: null },
    forex: { data: [], portfolio: null, stats: null, bots: null },
    commodities: { data: [], portfolio: null, stats: null, bots: null }
  });

  const timeStep = useRef(0);
  const intervalRef = useRef(null);
  const tradeIntervalRef = useRef(null);
  const marketFactorRef = useRef({ stocks: 1.0, crypto: 1.0, forex: 1.0, commodities: 1.0 });
  const marketTrend = useRef(0);
  const completedTradesRef = useRef({ stocks: [], crypto: [], forex: [], commodities: [] });
  const tradeHistoryRef = useRef({ stocks: [], crypto: [], forex: [], commodities: [] });

  // Using realistic current market prices (as of late 2024/early 2025)
  const ASSETS = useMemo(() => ({
    stocks: {
      AAPL: { volatility: 0.018, meanPrice: 195, color: '#3b82f6', name: 'Apple Inc.' },
      MSFT: { volatility: 0.016, meanPrice: 415, color: '#10b981', name: 'Microsoft' },
      NVDA: { volatility: 0.032, meanPrice: 495, color: '#f59e0b', name: 'NVIDIA' },
