                    <ResponsiveContainer width="100%" height={220}>
                      <LineChart data={data.slice(-60)}>
                        <CartesianGrid strokeDasharray="3 3" stroke="#334155" />
                        <XAxis dataKey="time" stroke="#94a3b8" tick={{ fontSize: 11 }} />
                        <YAxis stroke="#94a3b8" tick={{ fontSize: 11 }} domain={['auto', 'auto']} />
                        <Tooltip 
                          contentStyle={{ backgroundColor: '#1e293b', border: 'none', fontSize: 11 }} 
                          formatter={(value) => formatPrice(value, marketType)}
                        />
                        <Legend wrapperStyle={{ fontSize: 11 }} />
                        {Object.keys(assets).map(symbol => {
                          const hasPosition = (portfolio.positions?.[symbol] || 0) > 0 || (portfolio.shorts?.[symbol] || 0) > 0;
                          return (
                            <Line 
                              key={symbol}
                              type="monotone" 
                              dataKey={symbol} 
                              stroke={assets[symbol].color} 
                              dot={false} 
                              strokeWidth={hasPosition ? 3 : 2}
                              strokeOpacity={hasPosition ? 1 : 0.6}
                            />
                          );
                        })}
                      </LineChart>
                    </ResponsiveContainer>
                  </div>
                )}

                {/* Bot Performance */}
                <div className="grid grid-cols-3 gap-2 mb-3">
                  {Object.entries(bots).map(([name, bot]) => {
                    const totalTrades = bot.wins + bot.losses;
                    const winRate = totalTrades > 0 ? ((bot.wins / totalTrades) * 100).toFixed(0) : '0';
                    const scoreColor = bot.score > 120 ? 'text-green-400' : bot.score > 80 ? 'text-blue-400' : bot.score > 50 ? 'text-yellow-400' : 'text-red-400';
                    
                    return (
                      <div key={name} className="bg-slate-700 p-2 rounded text-xs">
                        <div className="font-bold capitalize text-[11px]">{name}</div>
                        <div className="flex justify-between items-center mt-1">
                          <span className={scoreColor}>S:{bot.score.toFixed(0)}</span>
                          <span className="text-slate-300">W:{winRate}%</span>
                        </div>
                      </div>
                    );
                  })}
                </div>

                {/* Current Positions */}
                <div className="space-y-1 max-h-48 overflow-y-auto">
                  <div className="font-semibold text-sm mb-2 sticky top-0 bg-slate-800">Positions:</div>
                  {Object.keys(assets).map(symbol => {
                    const shares = portfolio.positions?.[symbol] || 0;
                    const shorts = portfolio.shorts?.[symbol] || 0;
                    const price = data.length > 0 ? data[data.length - 1][symbol] : 0;
                    const entryPrice = portfolio.entryPrices?.[symbol];
                    const stopLoss = portfolio.stopLosses?.[symbol];
                    const takeProfit = portfolio.takeProfits?.[symbol];
                    const hasPosition = shares > 0 || shorts > 0;
                    
                    let pnlPercent = 0;
                    let positionValue = 0;
                    if (hasPosition && entryPrice) {
                      if (shares > 0) {
                        pnlPercent = ((price - entryPrice) / entryPrice) * 100;
                        positionValue = shares * price;
                      } else {
                        pnlPercent = ((entryPrice - price) / entryPrice) * 100;
                        positionValue = shorts * price;
                      }
                    }
                    
                    return (
                      <div key={symbol} className={`p-2 rounded text-xs ${hasPosition ? 'bg-slate-700' : 'bg-slate-700/30'}`}>
                        <div className="flex justify-between items-center">
                          <div className="flex items-center gap-2 flex-1">
                            <div className="w-2 h-2 rounded-full" style={{ backgroundColor: assets[symbol].color }}></div>
                            <div className="flex-1">
                              <div className="flex items-center gap-2">
                                <span className="font-bold">{symbol}</span>
                                <span className="text-slate-400">${formatPrice(price, marketType)}</span>
                              </div>
                              {hasPosition && (
                                <div className="text-[10px] text-slate-400 mt-0.5">
                                  {assets[symbol].name}
                                </div>
                              )}
                            </div>
                          </div>
                          <div className="text-right">
                            {shares > 0 && (
                              <div>
                                <div className="text-green-400 font-semibold">
                                  LONG {shares}
                                </div>
                                <div className={`text-xs ${pnlPercent >= 0 ? 'text-green-300' : 'text-red-300'}`}>
                                  {pnlPercent >= 0 ? '+' : ''}{pnlPercent.toFixed(1)}% · ${positionValue.toFixed(0)}
                                </div>
                                {stopLoss && takeProfit && (
                                  <div className="text-[10px] text-slate-400">
                                    SL:{stopLoss.toFixed(1)}% TP:{takeProfit.toFixed(1)}%
                                  </div>
                                )}
                              </div>
                            )}
                            {shorts > 0 && (
                              <div>
                                <div className="text-red-400 font-semibold">
                                  SHORT {shorts}
                                </div>
                                <div className={`text-xs ${pnlPercent >= 0 ? 'text-green-300' : 'text-red-300'}`}>
                                  {pnlPercent >= 0 ? '+' : ''}{pnlPercent.toFixed(1)}% · ${positionValue.toFixed(0)}
                                </div>
                                {stopLoss && takeProfit && (
                                  <div className="text-[10px] text-slate-400">
                                    SL:{stopLoss.toFixed(1)}% TP:{takeProfit.toFixed(1)}%
                                  </div>
                                )}
                              </div>
                            )}
                            {!hasPosition && <span className="text-slate-500">—</span>}
                          </div>
                        </div>
                      </div>
                    );
                  })}
                </div>
              </div>
            );
          })}
        </div>

        {/* Modals */}
        {showProfileModal && (
          <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
            <div className="bg-slate-800 rounded-lg p-6 max-w-2xl w-full">
              <div className="flex justify-between items-center mb-4">
                <h2 className="text-2xl font-bold">Trading Profiles</h2>
                <button onClick={() => setShowProfileModal(false)} className="text-slate-400 hover:text-white text-2xl">×</button>
              </div>
              <div className="grid grid-cols-1 md:grid-cols-2 gap-3">
                <button onClick={() => applyProfile('conservative')} className="p-4 bg-slate-700 hover:bg-slate-600 rounded-lg text-left">
                  <div className="font-bold text-green-400 text-lg mb-2">🛡️ Conservative</div>
                  <div className="text-sm text-slate-300">Risk: 75% | Invest: 10% | 1ns | SL: 4% | TP: 16% (Auto)</div>
                </button>
                <button onClick={() => applyProfile('balanced')} className="p-4 bg-slate-700 hover:bg-slate-600 rounded-lg text-left">
                  <div className="font-bold text-blue-400 text-lg mb-2">⚖️ Balanced</div>
                  <div className="text-sm text-slate-300">Risk: 78% | Invest: 18% | 1ns | SL: 2.5% | TP: 20% (Auto)</div>
                </button>
                <button onClick={() => applyProfile('aggressive')} className="p-4 bg-slate-700 hover:bg-slate-600 rounded-lg text-left">
                  <div className="font-bold text-orange-400 text-lg mb-2">🔥 Aggressive</div>
                  <div className="text-sm text-slate-300">Risk: 82% | Invest: 28% | 1ns | SL: 2% | TP: 25% (Auto)</div>
                </button>
                <button onClick={() => applyProfile('scalper')} className="p-4 bg-slate-700 hover:bg-slate-600 rounded-lg text-left">
                  <div className="font-bold text-red-400 text-lg mb-2">💨 Scalper</div>
                  <div className="text-sm text-slate-300">Risk: 88% | Invest: 22% | 1ns | SL: 1.5% | TP: 12% (Manual)</div>
                </button>
              </div>
            </div>
          </div>
        )}

        {showCapitalModal && (
          <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
            <div className="bg-slate-800 rounded-lg p-6 max-w-md w-full">
              <h2 className="text-2xl font-bold mb-4">Set Starting Capital</h2>
              <div className="space-y-4">
                <div>
                  <label className="text-sm text-slate-400 block mb-2">
                    Amount: {formatCurrency(startingCapital)}
                  </label>
                  <input 
                    type="number" 
                    min="10000" 
                    max="10000000" 
                    step="10000" 
                    value={startingCapital} 
                    onChange={(e) => setStartingCapital(Math.max(10000, Number(e.target.value)))} 
                    className="w-full px-4 py-2 bg-slate-700 rounded text-white" 
                  />
                </div>
                <div className="grid grid-cols-3 gap-2">
                  <button onClick={() => setStartingCapital(50000)} className="px-3 py-2 bg-slate-700 hover:bg-slate-600 rounded text-sm">$50k</button>
                  <button onClick={() => setStartingCapital(100000)} className="px-3 py-2 bg-slate-700 hover:bg-slate-600 rounded text-sm">$100k</button>
                  <button onClick={() => setStartingCapital(500000)} className="px-3 py-2 bg-slate-700 hover:bg-slate-600 rounded text-sm">$500k</button>
                  <button onClick={() => setStartingCapital(1000000)} className="px-3 py-2 bg-slate-700 hover:bg-slate-600 rounded text-sm">$1M</button>
                  <button onClick={() => setStartingCapital(5000000)} className="px-3 py-2 bg-slate-700 hover:bg-slate-600 rounded text-sm">$5M</button>
                  <button onClick={() => setStartingCapital(10000000)} className="px-3 py-2 bg-slate-700 hover:bg-slate-600 rounded text-sm">$10M</button>
                </div>
                <div className="flex gap-3 mt-4">
                  <button 
                    onClick={() => { setShowCapitalModal(false); initializeMarkets(); }} 
                    className="flex-1 px-6 py-2 bg-green-600 hover:bg-green-700 rounded-lg font-semibold"
                  >
                    Apply & Reset
                  </button>
                  <button 
                    onClick={() => setShowCapitalModal(false)} 
                    className="px-6 py-2 bg-slate-700 hover:bg-slate-600 rounded-lg font-semibold"
                  >
                    Cancel
                  </button>
                </div>
              </div>
            </div>
          </div>
        )}
      </div>
    </div>
  );
};

export default MultiMarketTradingSimulator;
