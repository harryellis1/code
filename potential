            const totalReturn = ((totalValue - capitalPerMarket) / capitalPerMarket) * 100;
            const completedTrades = completedTradesRef.current[marketType];
            const wins = completedTrades.filter(t => t.pnl > 0).length;
            const winRate = completedTrades.length > 0 ? (wins / completedTrades.length) * 100 : 0;

            let sharpeRatio = 0;
            if (newHistory.length > 30) {
              const returns = [];
              for (let i = 1; i < newHistory.length; i++) {
                const ret = (newHistory[i] - newHistory[i - 1]) / Math.max(newHistory[i - 1], 1);
                returns.push(ret);
              }
              if (returns.length > 0) {
                const avgReturn = returns.reduce((a, b) => a + b, 0) / returns.length;
                const variance = returns.reduce((sum, r) => sum + Math.pow(r - avgReturn, 2), 0) / Math.max(returns.length - 1, 1);
                const stdDev = Math.sqrt(variance);
                sharpeRatio = stdDev > 0.0001 ? (avgReturn / stdDev) * Math.sqrt(252) : 0;
              }
            }

            newMarkets[marketType].stats = {
              totalReturn: totalReturn.toFixed(2),
              winRate: winRate.toFixed(1),
              totalTrades: completedTrades.length,
              sharpeRatio: sharpeRatio.toFixed(2)
            };
          });

