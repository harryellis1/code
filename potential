import React, { useState, useEffect, useRef, useCallback } from 'react';
import { LineChart, Line, XAxis, YAxis, CartesianGrid, Tooltip, Legend, ResponsiveContainer } from 'recharts';
import { Play, Pause, RotateCcw, TrendingUp, TrendingDown } from 'lucide-react';

const QuantTradingSimulator = () => {
  const [isRunning, setIsRunning] = useState(false);
  const [marketMode, setMarketMode] = useState('normal');
  const [riskTolerance, setRiskTolerance] = useState(50);
  const [tradingFrequency, setTradingFrequency] = useState(100);
  const [investmentPercent, setInvestmentPercent] = useState(10);
  const [reserveAmount, setReserveAmount] = useState(10000);
  const [stopLossPercent, setStopLossPercent] = useState(5);
  const [startingCapital, setStartingCapital] = useState(100000);
  const [showCapitalModal, setShowCapitalModal] = useState(false);
  const [showProfileModal, setShowProfileModal] = useState(false);
  const [watchlist, setWatchlist] = useState([]);
  const [showWatchlistModal, setShowWatchlistModal] = useState(false);
  const [marketRegime, setMarketRegime] = useState('Normal');
  const [marketData, setMarketData] = useState([]);
  const [trades, setTrades] = useState([]);
  const [portfolio, setPortfolio] = useState({
    cash: 100000,
    positions: {},
    shorts: {},
    entryPrices: {},
    totalValue: 100000,
    history: [],
    peakValue: 100000
  });
  const [stats, setStats] = useState({
    totalReturn: 0,
    winRate: 0,
    totalTrades: 0,
    marketCondition: 'Normal',
    activeModel: 'Ensemble',
    sharpeRatio: 0,
    drawdown: 0
  });
  const [ensembleBots, setEnsembleBots] = useState({
    momentum: { score: 100, wins: 0, losses: 0, totalPnL: 0 },
    meanReversion: { score: 100, wins: 0, losses: 0, totalPnL: 0 },
    breakout: { score: 100, wins: 0, losses: 0, totalPnL: 0 },
    volatility: { score: 100, wins: 0, losses: 0, totalPnL: 0 },
    trend: { score: 100, wins: 0, losses: 0, totalPnL: 0 }
  });
  const tradeHistory = useRef([]);
  const timeStep = useRef(0);
  const intervalRef = useRef(null);
  const tradeIntervalRef = useRef(null);
  const marketFactor = useRef(1.0);
  const marketTrend = useRef(0);

  const STOCKS = {
    AAPL: { sector: 'tech', beta: 1.25, volatility: 0.018, meanPrice: 230, color: '#3b82f6', name: 'Apple Inc.' },
    MSFT: { sector: 'tech', beta: 1.15, volatility: 0.016, meanPrice: 500, color: '#10b981', name: 'Microsoft Corp.' },
    NVDA: { sector: 'tech', beta: 1.75, volatility: 0.032, meanPrice: 185, color: '#f59e0b', name: 'NVIDIA Corp.' },
    TSLA: { sector: 'auto', beta: 2.00, volatility: 0.038, meanPrice: 430, color: '#ef4444', name: 'Tesla Inc.' },
    GOOGL: { sector: 'tech', beta: 1.10, volatility: 0.019, meanPrice: 195, color: '#8b5cf6', name: 'Alphabet Inc.' },
    AMZN: { sector: 'retail', beta: 1.30, volatility: 0.022, meanPrice: 230, color: '#ec4899', name: 'Amazon.com Inc.' },
    META: { sector: 'tech', beta: 1.40, volatility: 0.025, meanPrice: 640, color: '#06b6d4', name: 'Meta Platforms' },
    JPM: { sector: 'finance', beta: 1.15, volatility: 0.020, meanPrice: 260, color: '#84cc16', name: 'JPMorgan Chase' },
    BAC: { sector: 'finance', beta: 1.20, volatility: 0.021, meanPrice: 48, color: '#f97316', name: 'Bank of America' },
    WMT: { sector: 'retail', beta: 0.60, volatility: 0.013, meanPrice: 105, color: '#14b8a6', name: 'Walmart Inc.' }
  };

  const generatePrice = useCallback((symbol, prevPrice, mode) => {
    const config = STOCKS[symbol];
    let volatilityMultiplier = 1;
    let trendBias = 0;

    if (mode === 'livemarket') volatilityMultiplier = 0.8;
    else if (mode === 'gorilla') volatilityMultiplier = 3;
    else if (mode === 'announcement') {
      volatilityMultiplier = 2;
      trendBias = marketTrend.current * 0.003;
    } else if (mode === 'crash') {
      volatilityMultiplier = 4;
      trendBias = -0.008;
    }

    const volatility = config.volatility * volatilityMultiplier;
    const randomShock = volatility * (Math.random() - 0.5) * 2;
    const marketShock = config.beta * (marketFactor.current - 1) * 0.02;
    const totalChange = prevPrice * (randomShock + marketShock + trendBias);
    const newPrice = prevPrice + totalChange;
    return Math.max(config.meanPrice * 0.3, Math.min(config.meanPrice * 2.0, newPrice));
  }, []);

  const calculateRSI = useCallback((prices) => {
    if (prices.length < 15) return 50;
    let gains = 0, losses = 0;
    for (let i = prices.length - 14; i < prices.length; i++) {
      if (i === 0) continue;
      const change = prices[i] - prices[i - 1];
      if (change > 0) gains += change;
      else losses -= change;
    }
    const avgGain = gains / 14;
    const avgLoss = losses / 14;
    return avgLoss === 0 ? 100 : 100 - (100 / (1 + avgGain / avgLoss));
  }, []);

  const detectMarketCondition = useCallback((data) => {
    if (data.length < 30) return { regime: 'Normal' };
    const recent = data.slice(-30);
    let totalChange = 0, volatilitySum = 0;
    
    Object.keys(STOCKS).forEach(symbol => {
      const prices = recent.map(d => d[symbol]);
      const change = (prices[29] - prices[0]) / prices[0];
      totalChange += change;
      
      let varianceSum = 0;
      for (let i = 1; i < 30; i++) {
        const ret = (prices[i] - prices[i-1]) / prices[i-1];
        varianceSum += ret * ret;
      }
      volatilitySum += Math.sqrt(varianceSum / 29);
    });
    
    const avgChange = totalChange / Object.keys(STOCKS).length;
    const avgVol = volatilitySum / Object.keys(STOCKS).length;
    
    if (avgChange < -0.10 && avgVol > 0.025) return { regime: 'Crisis' };
    if (avgChange < -0.05 && avgVol > 0.020) return { regime: 'Bear Market' };
    if (avgVol > 0.030) return { regime: 'Panic Selling' };
    if (Math.abs(avgChange) > 0.08) return { regime: avgChange > 0 ? 'Bull Market' : 'Distribution' };
    return { regime: 'Normal' };
  }, []);

  const initializeMarket = useCallback(() => {
    const initial = { time: 0 };
    Object.keys(STOCKS).forEach(symbol => {
      initial[symbol] = STOCKS[symbol].meanPrice;
    });
    setMarketData([initial]);
    setTrades([]);
    setPortfolio({
      cash: startingCapital,
      positions: {},
      shorts: {},
      entryPrices: {},
      totalValue: startingCapital,
      history: [startingCapital],
      peakValue: startingCapital
    });
    setStats({ totalReturn: 0, winRate: 0, totalTrades: 0, sharpeRatio: 0, drawdown: 0 });
    setEnsembleBots({
      momentum: { score: 100, wins: 0, losses: 0, totalPnL: 0 },
      meanReversion: { score: 100, wins: 0, losses: 0, totalPnL: 0 },
      breakout: { score: 100, wins: 0, losses: 0, totalPnL: 0 },
      volatility: { score: 100, wins: 0, losses: 0, totalPnL: 0 },
      trend: { score: 100, wins: 0, losses: 0, totalPnL: 0 }
    });
    tradeHistory.current = [];
    timeStep.current = 0;
    marketFactor.current = 1.0;
  }, [startingCapital]);

  useEffect(() => {
    initializeMarket();
  }, [initializeMarket]);

  useEffect(() => {
    setPortfolio(prev => ({
      ...prev,
      cash: startingCapital,
      totalValue: startingCapital,
      history: [startingCapital],
      peakValue: startingCapital
    }));
  }, [startingCapital]);

  useEffect(() => {
    if (intervalRef.current) clearInterval(intervalRef.current);
    if (tradeIntervalRef.current) clearInterval(tradeIntervalRef.current);
    
    if (isRunning) {
      intervalRef.current = setInterval(() => {
        setMarketData(prevData => {
          const lastData = prevData[prevData.length - 1];
          if (!lastData) return prevData;

          if (marketMode === 'announcement') {
            marketTrend.current = Math.random() > 0.5 ? 1 : -1;
            marketFactor.current += marketTrend.current * 0.02;
          } else if (marketMode === 'crash') {
            marketFactor.current -= 0.015;
          } else {
            marketFactor.current += (Math.random() - 0.5) * 0.01;
          }
          marketFactor.current = Math.max(0.7, Math.min(1.3, marketFactor.current));

          const newData = { time: timeStep.current + 1 };
          Object.keys(STOCKS).forEach(symbol => {
            newData[symbol] = generatePrice(symbol, lastData[symbol], marketMode);
          });

          if (marketMode === 'livemarket' && watchlist.length > 0) {
            Object.keys(STOCKS).forEach(symbol => {
              if (!watchlist.includes(symbol)) newData[symbol] = lastData[symbol];
            });
          }

          timeStep.current++;
          
          setPortfolio(prev => {
            let totalValue = prev.cash;
            Object.keys(prev.positions).forEach(sym => {
              totalValue += prev.positions[sym] * newData[sym];
            });
            Object.keys(prev.shorts).forEach(sym => {
              totalValue -= prev.shorts[sym] * newData[sym];
            });
            return {
              ...prev,
              totalValue,
              history: [...prev.history, totalValue].slice(-200)
            };
          });

          return [...prevData, newData].slice(-200);
        });
      }, 50);
      
      tradeIntervalRef.current = setInterval(() => {
        setMarketData(prevData => {
          if (prevData.length < 20) return prevData;
          
          const newData = prevData[prevData.length - 1];
          const marketInfo = detectMarketCondition(prevData);
          setMarketRegime(marketInfo.regime);
          
          setPortfolio(prevPortfolio => {
            const signals = [];
            const activeSymbols = marketMode === 'livemarket' && watchlist.length > 0 ? watchlist : Object.keys(STOCKS);
            
            activeSymbols.forEach(symbol => {
              if (!newData[symbol]) return;
              const prices = prevData.map(d => d[symbol]).filter(p => p);
              if (prices.length < 20) return;
              
              const currentPrice = prices[prices.length - 1];
              const rsi = calculateRSI(prices);
              
              const ma5 = prices.slice(-5).reduce((a, b) => a + b, 0) / 5;
              const ma10 = prices.slice(-10).reduce((a, b) => a + b, 0) / 10;
              const ma20 = prices.slice(-20).reduce((a, b) => a + b, 0) / 20;
              
              const momentum5 = (currentPrice - prices[prices.length - 5]) / prices[prices.length - 5];
              const momentum10 = (currentPrice - prices[prices.length - 10]) / prices[prices.length - 10];
              
              let varSum = 0;
              for (let i = prices.length - 20; i < prices.length - 1; i++) {
                const ret = (prices[i + 1] - prices[i]) / prices[i];
                varSum += ret * ret;
              }
              const volatility = Math.sqrt(varSum / 18);
              
              const slice30 = prices.slice(-30);
              const mean = slice30.reduce((a, b) => a + b, 0) / slice30.length;
              const variance = slice30.reduce((s, p) => s + Math.pow(p - mean, 2), 0) / slice30.length;
              const zScore = (currentPrice - mean) / Math.sqrt(variance);
              
              const botSignals = [];
              
              // 5 Bot Strategies
              if (momentum5 > 0.02 && momentum10 > 0.03 && rsi > 50 && rsi < 70) {
                botSignals.push({ action: 'BUY', confidence: 88, reason: 'Strong momentum', bot: 'momentum', weight: ensembleBots.momentum.score });
              }
              if (zScore < -2.5 && rsi < 30) {
                botSignals.push({ action: 'BUY', confidence: 90, reason: 'Mean reversion', bot: 'meanReversion', weight: ensembleBots.meanReversion.score });
              }
              if (currentPrice > ma20 * 1.03 && momentum5 > 0.015 && volatility > 0.02) {
                botSignals.push({ action: 'BUY', confidence: 85, reason: 'Breakout', bot: 'breakout', weight: ensembleBots.breakout.score });
              }
              if (volatility < 0.015 && rsi < 40 && momentum5 > 0) {
                botSignals.push({ action: 'BUY', confidence: 82, reason: 'Low vol bounce', bot: 'volatility', weight: ensembleBots.volatility.score });
              }
              if (ma5 > ma10 && ma10 > ma20 && rsi < 60) {
                botSignals.push({ action: 'BUY', confidence: 86, reason: 'Uptrend', bot: 'trend', weight: ensembleBots.trend.score });
              }
              
              // Short signals
              if (momentum5 < -0.02 && momentum10 < -0.03 && rsi < 50) {
                botSignals.push({ action: 'SHORT', confidence: 88, reason: 'Neg momentum', bot: 'momentum', weight: ensembleBots.momentum.score });
              }
              if (zScore > 2.5 && rsi > 70) {
                botSignals.push({ action: 'SHORT', confidence: 90, reason: 'Overextended', bot: 'meanReversion', weight: ensembleBots.meanReversion.score });
              }
              if (volatility > 0.03 && marketInfo.regime === 'Crisis') {
                botSignals.push({ action: 'SHORT', confidence: 92, reason: 'Crisis vol', bot: 'volatility', weight: ensembleBots.volatility.score });
              }
              
              let decision = 'HOLD';
              let confidence = 50;
              let reason = '';
              let selectedBot = null;
              
              // Judge picks best bot
              if (botSignals.length > 0) {
                const scored = botSignals.map(s => ({
                  ...s,
                  score: s.confidence * (s.weight / 100)
                })).sort((a, b) => b.score - a.score);
                
                const best = scored[0];
                if (best.score >= riskTolerance) {
                  decision = best.action;
                  confidence = best.confidence;
                  reason = best.reason;
                  selectedBot = best.bot;
                }
              }
              
              // Exit logic
              const hasLong = prevPortfolio.positions[symbol] > 0;
              const hasShort = prevPortfolio.shorts[symbol] > 0;
              
              if (hasLong) {
                const entryPrice = prevPortfolio.entryPrices[symbol] || currentPrice;
                const pnl = (currentPrice - entryPrice) / entryPrice;
                if (pnl > 0.10 || pnl < -stopLossPercent / 100) {
                  decision = 'SELL';
                  confidence = 98;
                  reason = pnl > 0 ? 'Take profit' : 'Stop loss';
                }
              }
              
              if (hasShort) {
                const entryPrice = prevPortfolio.entryPrices[symbol] || currentPrice;
                const pnl = (entryPrice - currentPrice) / entryPrice;
                if (pnl > 0.08 || pnl < -stopLossPercent / 100) {
                  decision = 'COVER';
                  confidence = 98;
                  reason = pnl > 0 ? 'Cover profit' : 'Cover loss';
                }
              }
              
              if (decision !== 'HOLD' && confidence >= riskTolerance) {
                signals.push({ symbol, action: decision, successRate: confidence, reason, bot: selectedBot, entryPrice: currentPrice });
              }
            });
            
            const newPortfolio = { 
              ...prevPortfolio, 
              positions: { ...prevPortfolio.positions }, 
              shorts: { ...prevPortfolio.shorts }, 
              entryPrices: { ...prevPortfolio.entryPrices } 
            };
            const newTrades = [];
            
            signals.forEach(signal => {
              const price = newData[signal.symbol];
              if (!price) return;
              
              if (signal.action === 'BUY') {
                const positionSize = Math.min(newPortfolio.cash - reserveAmount, newPortfolio.cash * (investmentPercent / 100));
                const shares = Math.floor(positionSize / price);
                if (shares > 0 && newPortfolio.cash >= shares * price + reserveAmount) {
                  newPortfolio.cash -= shares * price;
                  newPortfolio.positions[signal.symbol] = (newPortfolio.positions[signal.symbol] || 0) + shares;
                  newPortfolio.entryPrices[signal.symbol] = price;
                  newTrades.push({ symbol: signal.symbol, action: 'BUY', shares, price: price.toFixed(2), bot: signal.bot });
                  tradeHistory.current.push({ symbol: signal.symbol, bot: signal.bot, entryPrice: price, action: 'BUY' });
                }
              } 
              else if (signal.action === 'SHORT') {
                const positionSize = Math.min(newPortfolio.cash * 0.5, newPortfolio.cash * (investmentPercent / 100));
                const shares = Math.floor(positionSize / price);
                if (shares > 0) {
                  newPortfolio.cash += shares * price;
                  newPortfolio.shorts[signal.symbol] = (newPortfolio.shorts[signal.symbol] || 0) + shares;
                  newPortfolio.entryPrices[signal.symbol] = price;
                  newTrades.push({ symbol: signal.symbol, action: 'SHORT', shares, price: price.toFixed(2), bot: signal.bot });
                  tradeHistory.current.push({ symbol: signal.symbol, bot: signal.bot, entryPrice: price, action: 'SHORT' });
                }
              }
              else if (signal.action === 'SELL' && newPortfolio.positions[signal.symbol] > 0) {
                const shares = newPortfolio.positions[signal.symbol];
                const entryPrice = newPortfolio.entryPrices[signal.symbol] || price;
                const pnl = (price - entryPrice) * shares;
                const pnlPercent = ((price - entryPrice) / entryPrice) * 100;
                
                newPortfolio.cash += shares * price;
                delete newPortfolio.positions[signal.symbol];
                delete newPortfolio.entryPrices[signal.symbol];
                newTrades.push({ symbol: signal.symbol, action: 'SELL', shares, price: price.toFixed(2), pnl: pnl.toFixed(2), pnlPercent: pnlPercent.toFixed(2) });
                
                const trade = tradeHistory.current.find(t => t.symbol === signal.symbol && t.action === 'BUY');
                if (trade && trade.bot) {
                  setEnsembleBots(prev => {
                    const bot = prev[trade.bot];
                    if (!bot) return prev;
                    const reward = pnl > 0 ? Math.min(50, pnl / 100) : Math.max(-50, pnl / 50);
                    return {
                      ...prev,
                      [trade.bot]: {
                        score: Math.max(10, Math.min(200, bot.score + reward)),
                        wins: pnl > 0 ? bot.wins + 1 : bot.wins,
                        losses: pnl < 0 ? bot.losses + 1 : bot.losses,
                        totalPnL: bot.totalPnL + pnl
                      }
                    };
                  });
                  tradeHistory.current = tradeHistory.current.filter(t => !(t.symbol === signal.symbol && t.action === 'BUY'));
                }
              }
              else if (signal.action === 'COVER' && newPortfolio.shorts[signal.symbol] > 0) {
                const shares = newPortfolio.shorts[signal.symbol];
                const entryPrice = newPortfolio.entryPrices[signal.symbol] || price;
                const pnl = (entryPrice - price) * shares;
                const pnlPercent = ((entryPrice - price) / entryPrice) * 100;
                
                newPortfolio.cash -= shares * price;
                delete newPortfolio.shorts[signal.symbol];
                delete newPortfolio.entryPrices[signal.symbol];
                newTrades.push({ symbol: signal.symbol, action: 'COVER', shares, price: price.toFixed(2), pnl: pnl.toFixed(2), pnlPercent: pnlPercent.toFixed(2) });
                
                const trade = tradeHistory.current.find(t => t.symbol === signal.symbol && t.action === 'SHORT');
                if (trade && trade.bot) {
                  setEnsembleBots(prev => {
                    const bot = prev[trade.bot];
                    if (!bot) return prev;
                    const reward = pnl > 0 ? Math.min(50, pnl / 100) : Math.max(-50, pnl / 50);
                    return {
                      ...prev,
                      [trade.bot]: {
                        score: Math.max(10, Math.min(200, bot.score + reward)),
                        wins: pnl > 0 ? bot.wins + 1 : bot.wins,
                        losses: pnl < 0 ? bot.losses + 1 : bot.losses,
                        totalPnL: bot.totalPnL + pnl
                      }
                    };
                  });
                  tradeHistory.current = tradeHistory.current.filter(t => !(t.symbol === signal.symbol && t.action === 'SHORT'));
                }
              }
            });
            
            let totalValue = newPortfolio.cash;
            Object.keys(newPortfolio.positions).forEach(sym => {
              totalValue += newPortfolio.positions[sym] * newData[sym];
            });
            Object.keys(newPortfolio.shorts).forEach(sym => {
              totalValue -= newPortfolio.shorts[sym] * newData[sym];
            });
            
            const peakValue = Math.max(prevPortfolio.peakValue, totalValue);
            newPortfolio.totalValue = totalValue;
            newPortfolio.peakValue = peakValue;
            newPortfolio.history = [...prevPortfolio.history, totalValue].slice(-200);

            if (newTrades.length > 0) {
              setTrades(prev => [...prev, ...newTrades].slice(-50));
            }

            const totalReturn = ((totalValue - startingCapital) / startingCapital) * 100;
            const drawdown = ((peakValue - totalValue) / peakValue) * 100;
            
            const completedTrades = trades.filter(t => t.pnl !== undefined);
            const wins = completedTrades.filter(t => parseFloat(t.pnl) > 0).length;
            const winRate = completedTrades.length > 0 ? (wins / completedTrades.length) * 100 : 0;
            
            let sharpeRatio = 0;
            if (newPortfolio.history.length > 30) {
              const returns = [];
              for (let i = 1; i < newPortfolio.history.length; i++) {
                returns.push((newPortfolio.history[i] - newPortfolio.history[i - 1]) / newPortfolio.history[i - 1]);
              }
              const avgReturn = returns.reduce((a, b) => a + b, 0) / returns.length;
              const variance = returns.reduce((sum, r) => sum + Math.pow(r - avgReturn, 2), 0) / (returns.length - 1);
              const stdDev = Math.sqrt(variance);
              sharpeRatio = stdDev > 0 ? (avgReturn / stdDev) * Math.sqrt(252) : 0;
            }
            
            setStats({
              totalReturn: totalReturn.toFixed(2),
              winRate: winRate.toFixed(1),
              totalTrades: completedTrades.length,
              sharpeRatio: sharpeRatio.toFixed(2),
              drawdown: drawdown.toFixed(2)
            });

            return newPortfolio;
          });

          return prevData;
        });
      }, tradingFrequency);
    }
    
    return () => {
      if (intervalRef.current) clearInterval(intervalRef.current);
      if (tradeIntervalRef.current) clearInterval(tradeIntervalRef.current);
    };
  }, [isRunning, marketMode, tradingFrequency, watchlist, generatePrice, calculateRSI, detectMarketCondition, riskTolerance, investmentPercent, stopLossPercent, reserveAmount, startingCapital, ensembleBots, trades]);

  const reset = () => {
    setIsRunning(false);
    initializeMarket();
  };

  const toggleWatchlist = (symbol) => {
    setWatchlist(prev => prev.includes(symbol) ? prev.filter(s => s !== symbol) : [...prev, symbol]);
  };

  const applyProfile = (profile) => {
    const profiles = {
      conservative: { risk: 60, freq: 500, inv: 5, res: 30000, stop: 7 },
      balanced: { risk: 65, freq: 75, inv: 12, res: 12000, stop: 4 },
      aggressive: { risk: 75, freq: 20, inv: 25, res: 3000, stop: 3 },
      hft: { risk: 85, freq: 1, inv: 15, res: 10000, stop: 3 },
      whale: { risk: 75, freq: 10, inv: 8, res: 50000, stop: 5, cap: 100000000 }
    };
    const p = profiles[profile];
    if (p) {
      setRiskTolerance(p.risk);
      setTradingFrequency(p.freq);
      setInvestmentPercent(p.inv);
      setReserveAmount(p.res);
      setStopLossPercent(p.stop);
      if (p.cap) setStartingCapital(p.cap);
      setShowProfileModal(false);
    }
  };

  return (
    <div className="w-full min-h-screen bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 text-white p-6">
      <div className="max-w-7xl mx-auto space-y-6">
        <div className="flex justify-between items-center">
          <h1 className="text-3xl font-bold bg-gradient-to-r from-blue-400 to-purple-400 bg-clip-text text-transparent">
            AI Trading System 🤖
          </h1>
          <div className="flex gap-3">
            <select value={marketMode} onChange={(e) => setMarketMode(e.target.value)} className="px-4 py-2 bg-slate-700 rounded-lg font-semibold">
              <option value="normal">Normal Market</option>
              <option value="gorilla">Gorilla Mode</option>
              <option value="announcement">Major Announcement</option>
              <option value="crash">Market Crash</option>
              <option value="livemarket">Live Market Demo</option>
            </select>
            <button onClick={() => setShowProfileModal(true)} className="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 rounded-lg font-semibold">
              Profiles
            </button>
            {marketMode === 'livemarket' && (
              <button onClick={() => setShowWatchlistModal(true)} className="px-4 py-2 bg-blue-600 hover:bg-blue-700 rounded-lg font-semibold">
                Watchlist ({watchlist.length})
              </button>
            )}
            <button onClick={() => setShowCapitalModal(true)} className="px-4 py-2 bg-purple-600 hover:bg-purple-700 rounded-lg font-semibold">
              £{startingCapital >= 1000000 ? (startingCapital / 1000000).toFixed(1) + 'M' : startingCapital >= 1000 ? (startingCapital / 1000).toFixed(0) + 'k' : startingCapital}
            </button>
            <button onClick={() => setIsRunning(!isRunning)} className={`px-6 py-2 rounded-lg flex items-center gap-2 font-semibold ${isRunning ? 'bg-red-600 hover:bg-red-700' : 'bg-green-600 hover:bg-green-700'}`}>
              {isRunning ? <Pause size={20} /> : <Play size={20} />}
            </button>
            <button onClick={reset} className="px-6 py-2 bg-slate-700 hover:bg-slate-600 rounded-lg flex items-center gap-2">
              <RotateCcw size={20} />
            </button>
          </div>
        </div>

        <div className="grid grid-cols-5 gap-4">
          <div className="bg-slate-800 p-4 rounded-lg">
            <label className="text-sm font-medium block mb-2">Risk Tolerance: {riskTolerance}%</label>
            <input type="range" min="10" max="100" value={riskTolerance} onChange={(e) => setRiskTolerance(Number(e.target.value))} className="w-full" />
          </div>
          <div className="bg-slate-800 p-4 rounded-lg">
            <label className="text-sm font-medium block mb-2">Trading Speed: {tradingFrequency}ms</label>
            <input type="range" min="1" max="2000" value={tradingFrequency} onChange={(e) => setTradingFrequency(Number(e.target.value))} className="w-full" />
          </div>
          <div className="bg-slate-800 p-4 rounded-lg">
            <label className="text-sm font-medium block mb-2">Investment: {investmentPercent}%</label>
            <input type="range" min="1" max="50" value={investmentPercent} onChange={(e) => setInvestmentPercent(Number(e.target.value))} className="w-full" />
          </div>
          <div className="bg-slate-800 p-4 rounded-lg">
            <label className="text-sm font-medium block mb-2">Reserve: ${(reserveAmount / 1000).toFixed(0)}k</label>
            <input type="range" min="0" max="50000" step="1000" value={reserveAmount} onChange={(e) => setReserveAmount(Number(e.target.value))} className="w-full" />
          </div>
          <div className="bg-slate-800 p-4 rounded-lg">
            <label className="text-sm font-medium block mb-2">Stop Loss: {stopLossPercent}%</label>
            <input type="range" min="1" max="20" value={stopLossPercent} onChange={(e) => setStopLossPercent(Number(e.target.value))} className="w-full" />
          </div>
        </div>

        <div className="grid grid-cols-5 gap-4">
          <div className="bg-slate-800 p-4 rounded-lg">
            <div className="text-sm text-slate-400">Portfolio Value</div>
            <div className="text-2xl font-bold">
              £{portfolio.totalValue >= 1000000 ? (portfolio.totalValue / 1000000).toFixed(2) + 'M' : portfolio.totalValue >= 1000 ? (portfolio.totalValue / 1000).toFixed(1) + 'k' : portfolio.totalValue.toFixed(0)}
            </div>
          </div>
          <div className="bg-slate-800 p-4 rounded-lg">
            <div className="text-sm text-slate-400">Total Return</div>
            <div className={`text-2xl font-bold ${parseFloat(stats.totalReturn) >= 0 ? 'text-green-400' : 'text-red-400'}`}>
              {stats.totalReturn}%
            </div>
          </div>
          <div className="bg-slate-800 p-4 rounded-lg">
            <div className="text-sm text-slate-400">Sharpe Ratio</div>
            <div className="text-2xl font-bold text-blue-400">{stats.sharpeRatio}</div>
          </div>
          <div className="bg-slate-800 p-4 rounded-lg">
            <div className="text-sm text-slate-400">Win Rate</div>
            <div className="text-2xl font-bold text-purple-400">{stats.winRate}%</div>
          </div>
          <div className="bg-slate-800 p-4 rounded-lg">
            <div className="text-sm text-slate-400">Market Regime</div>
            <div className={`text-lg font-bold ${
              marketRegime === 'Crisis' ? 'text-red-500' :
              marketRegime === 'Bear Market' ? 'text-orange-500' :
              marketRegime === 'Bull Market' ? 'text-green-500' :
              'text-blue-400'
            }`}>{marketRegime}</div>
          </div>
        </div>
        
        <div className="grid grid-cols-5 gap-4">
          <div className="bg-slate-800 p-4 rounded-lg">
            <div className="text-sm text-slate-400">Total Trades</div>
            <div className="text-2xl font-bold">{stats.totalTrades}</div>
          </div>
          <div className="bg-slate-800 p-4 rounded-lg">
            <div className="text-sm text-slate-400">Max Drawdown</div>
            <div className="text-2xl font-bold text-red-400">{stats.drawdown}%</div>
          </div>
          <div className="bg-slate-800 p-4 rounded-lg">
            <div className="text-sm text-slate-400">Cash Reserve</div>
            <div className="text-xl font-bold text-green-400">
              £{portfolio.cash >= 1000000 ? (portfolio.cash / 1000000).toFixed(2) + 'M' : portfolio.cash >= 1000 ? (portfolio.cash / 1000).toFixed(1) + 'k' : portfolio.cash.toFixed(0)}
            </div>
          </div>
          <div className="bg-slate-800 p-4 rounded-lg">
            <div className="text-sm text-slate-400">Open Positions</div>
            <div className="text-2xl font-bold text-yellow-400">
              {Object.keys(portfolio.positions).length + Object.keys(portfolio.shorts).length}
            </div>
          </div>
          <div className="bg-slate-800 p-4 rounded-lg">
            <div className="text-sm text-slate-400">Active Strategy</div>
            <div className="text-sm font-bold text-cyan-400">Ensemble Judge</div>
          </div>
        </div>

        <div className="bg-slate-800 p-6 rounded-lg">
          <h2 className="text-xl font-semibold mb-4">Ensemble Bot Performance 🤖</h2>
          <div className="grid grid-cols-5 gap-4">
            {Object.entries(ensembleBots).map(([name, bot]) => {
              const totalTrades = bot.wins + bot.losses;
              const winRate = totalTrades > 0 ? ((bot.wins / totalTrades) * 100).toFixed(1) : '0.0';
              const scoreColor = bot.score > 120 ? 'text-green-400' : bot.score > 80 ? 'text-blue-400' : bot.score > 50 ? 'text-yellow-400' : 'text-red-400';
              
              return (
                <div key={name} className="bg-slate-700 p-4 rounded-lg">
                  <div className="font-bold text-lg capitalize mb-2">{name}</div>
                  <div className="space-y-1 text-sm">
                    <div className={`font-bold ${scoreColor}`}>Score: {bot.score.toFixed(0)}</div>
                    <div className="text-slate-300">W/L: {bot.wins}/{bot.losses}</div>
                    <div className="text-slate-300">Win Rate: {winRate}%</div>
                    <div className={bot.totalPnL >= 0 ? 'text-green-400' : 'text-red-400'}>
                      PnL: £{bot.totalPnL.toFixed(0)}
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
          <div className="mt-4 text-sm text-slate-400 text-center">
            Bots compete for trade execution. Winners gain influence (score), losers get penalized.
          </div>
        </div>

        <div className="bg-slate-800 p-6 rounded-lg">
          <h2 className="text-xl font-semibold mb-4">Market Prices</h2>
          <ResponsiveContainer width="100%" height={300}>
            <LineChart data={marketData.slice(-60)}>
              <CartesianGrid strokeDasharray="3 3" stroke="#334155" />
              <XAxis dataKey="time" stroke="#94a3b8" />
              <YAxis stroke="#94a3b8" />
              <Tooltip contentStyle={{ backgroundColor: '#1e293b', border: 'none' }} />
              <Legend />
              <Line type="monotone" dataKey="AAPL" stroke="#3b82f6" dot={false} strokeWidth={2} />
              <Line type="monotone" dataKey="MSFT" stroke="#10b981" dot={false} strokeWidth={2} />
              <Line type="monotone" dataKey="NVDA" stroke="#f59e0b" dot={false} strokeWidth={2} />
              <Line type="monotone" dataKey="TSLA" stroke="#ef4444" dot={false} strokeWidth={2} />
            </LineChart>
          </ResponsiveContainer>
        </div>

        <div className="grid grid-cols-2 gap-4">
          <div className="bg-slate-800 p-6 rounded-lg">
            <h2 className="text-xl font-semibold mb-4">Current Positions</h2>
            <div className="space-y-2 max-h-96 overflow-y-auto">
              {Object.keys(STOCKS).map(symbol => {
                const shares = portfolio.positions[symbol] || 0;
                const shorts = portfolio.shorts[symbol] || 0;
                const price = marketData.length > 0 ? marketData[marketData.length - 1][symbol] : 0;
                const config = STOCKS[symbol];
                const hasPosition = shares > 0 || shorts > 0;
                
                return (
                  <div key={symbol} className={`p-3 rounded-lg ${hasPosition ? 'bg-slate-700' : 'bg-slate-700/30'}`}>
                    <div className="flex justify-between">
                      <div>
                        <div className="flex items-center gap-2">
                          <div className="w-3 h-3 rounded-full" style={{ backgroundColor: config.color }}></div>
                          <span className="font-bold">{symbol}</span>
                          <span className="text-xs text-slate-400">{config.sector}</span>
                        </div>
                        <div className="text-sm text-slate-400">
                          {shares > 0 && <div className="text-green-400">LONG: {shares} @ ${price ? price.toFixed(2) : '0'}</div>}
                          {shorts > 0 && <div className="text-red-400">SHORT: {shorts} @ ${price ? price.toFixed(2) : '0'}</div>}
                          {!hasPosition && 'No position'}
                        </div>
                      </div>
                      {hasPosition && price && (
                        <div className="text-right">
                          {shares > 0 && <div className="font-bold text-green-400">${(shares * price).toFixed(2)}</div>}
                          {shorts > 0 && <div className="font-bold text-red-400">-${(shorts * price).toFixed(2)}</div>}
                        </div>
                      )}
                    </div>
                  </div>
                );
              })}
            </div>
          </div>

          <div className="bg-slate-800 p-6 rounded-lg">
            <h2 className="text-xl font-semibold mb-4">Recent Trades</h2>
            <div className="space-y-2 max-h-96 overflow-y-auto">
              {trades.length === 0 ? (
                <div className="text-slate-400 text-center py-8">No trades yet</div>
              ) : (
                trades.slice().reverse().map((trade, idx) => (
                  <div key={idx} className="p-3 bg-slate-700 rounded-lg text-sm">
                    <div className="flex justify-between items-center">
                      <div className="flex items-center gap-2">
                        {trade.action === 'BUY' && <TrendingUp className="text-green-400" size={16} />}
                        {trade.action === 'SHORT' && <TrendingDown className="text-red-400" size={16} />}
                        {trade.action === 'SELL' && <TrendingDown className="text-orange-400" size={16} />}
                        {trade.action === 'COVER' && <TrendingUp className="text-yellow-400" size={16} />}
                        <span className="font-bold">{trade.symbol}</span>
                        {trade.bot && <span className="text-xs bg-slate-600 px-2 py-1 rounded">{trade.bot}</span>}
                      </div>
                      <div className="text-right">
                        <div className={trade.action === 'BUY' ? 'text-green-400' : trade.action === 'SHORT' ? 'text-red-400' : trade.action === 'SELL' ? 'text-orange-400' : 'text-yellow-400'}>
                          {trade.action} {trade.shares}
                        </div>
                        <div className="text-xs text-slate-400">
                          @${trade.price}
                          {trade.pnl && (
                            <span className={parseFloat(trade.pnl) >= 0 ? 'text-green-400 ml-2' : 'text-red-400 ml-2'}>
                              {parseFloat(trade.pnl) >= 0 ? '+' : ''}£{trade.pnl} ({trade.pnlPercent}%)
                            </span>
                          )}
                        </div>
                      </div>
                    </div>
                  </div>
                ))
              )}
            </div>
          </div>
        </div>
        
        {showProfileModal && (
          <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
            <div className="bg-slate-800 rounded-lg p-6 max-w-4xl w-full mx-4 max-h-96 overflow-y-auto">
              <div className="flex justify-between items-center mb-4">
                <h2 className="text-2xl font-bold">Trading Profiles</h2>
                <button onClick={() => setShowProfileModal(false)} className="text-slate-400 hover:text-white text-2xl">×</button>
              </div>
              <div className="grid grid-cols-2 gap-3">
                <button onClick={() => applyProfile('conservative')} className="p-4 bg-slate-700 hover:bg-slate-600 rounded-lg text-left">
                  <div className="font-bold text-green-400 text-lg mb-2">🛡️ Conservative</div>
                  <div className="text-sm text-slate-300">Risk: 60% | Speed: 500ms | Investment: 5%</div>
                </button>
                <button onClick={() => applyProfile('balanced')} className="p-4 bg-slate-700 hover:bg-slate-600 rounded-lg text-left">
                  <div className="font-bold text-blue-400 text-lg mb-2">⚖️ Balanced</div>
                  <div className="text-sm text-slate-300">Risk: 65% | Speed: 75ms | Investment: 12%</div>
                </button>
                <button onClick={() => applyProfile('aggressive')} className="p-4 bg-slate-700 hover:bg-slate-600 rounded-lg text-left">
                  <div className="font-bold text-orange-400 text-lg mb-2">🔥 Aggressive</div>
                  <div className="text-sm text-slate-300">Risk: 75% | Speed: 20ms | Investment: 25%</div>
                </button>
                <button onClick={() => applyProfile('hft')} className="p-4 bg-slate-700 hover:bg-slate-600 rounded-lg text-left">
                  <div className="font-bold text-yellow-400 text-lg mb-2">⚡ HFT Algo</div>
                  <div className="text-sm text-slate-300">Risk: 85% | Speed: 1ms | Investment: 15%</div>
                </button>
                <button onClick={() => applyProfile('whale')} className="p-4 bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-700 hover:to-pink-700 rounded-lg text-left col-span-2">
                  <div className="font-bold text-white text-lg mb-2">🐋 Whale Mode</div>
                  <div className="text-sm text-white">Risk: 75% | Speed: 10ms | Capital: £100M</div>
                </button>
              </div>
            </div>
          </div>
        )}
        
        {showCapitalModal && (
          <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
            <div className="bg-slate-800 rounded-lg p-6 max-w-md w-full mx-4">
              <h2 className="text-2xl font-bold mb-4">Set Starting Capital</h2>
              <div className="space-y-4">
                <div>
                  <label className="text-sm text-slate-400 block mb-2">
                    Amount: £{startingCapital >= 1000000 ? (startingCapital / 1000000).toFixed(1) + 'M' : (startingCapital / 1000).toFixed(0) + 'k'}
                  </label>
                  <input type="number" min="1000" max="1000000000" step="1000" value={startingCapital} onChange={(e) => setStartingCapital(Math.max(1000, Number(e.target.value)))} className="w-full px-4 py-2 bg-slate-700 rounded text-white" />
                </div>
                <div className="grid grid-cols-3 gap-2">
                  <button onClick={() => setStartingCapital(10000)} className="px-3 py-2 bg-slate-700 hover:bg-slate-600 rounded text-sm">£10k</button>
                  <button onClick={() => setStartingCapital(100000)} className="px-3 py-2 bg-slate-700 hover:bg-slate-600 rounded text-sm">£100k</button>
                  <button onClick={() => setStartingCapital(1000000)} className="px-3 py-2 bg-slate-700 hover:bg-slate-600 rounded text-sm">£1M</button>
                  <button onClick={() => setStartingCapital(10000000)} className="px-3 py-2 bg-slate-700 hover:bg-slate-600 rounded text-sm">£10M</button>
                  <button onClick={() => setStartingCapital(100000000)} className="px-3 py-2 bg-slate-700 hover:bg-slate-600 rounded text-sm">£100M</button>
                </div>
                <div className="flex gap-3 mt-4">
                  <button onClick={() => { setShowCapitalModal(false); initializeMarket(); }} className="flex-1 px-6 py-2 bg-green-600 hover:bg-green-700 rounded-lg font-semibold">
                    Apply & Reset
                  </button>
                  <button onClick={() => setShowCapitalModal(false)} className="px-6 py-2 bg-slate-700 hover:bg-slate-600 rounded-lg font-semibold">
                    Cancel
                  </button>
                </div>
              </div>
            </div>
          </div>
        )}
        
        {showWatchlistModal && (
          <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
            <div className="bg-slate-800 rounded-lg p-6 max-w-4xl w-full mx-4 max-h-96 overflow-y-auto">
              <div className="flex justify-between items-center mb-4">
                <h2 className="text-2xl font-bold">Select Stocks for Watchlist</h2>
                <button onClick={() => setShowWatchlistModal(false)} className="text-slate-400 hover:text-white text-2xl">×</button>
              </div>
              <div className="grid grid-cols-2 gap-2">
                {Object.keys(STOCKS).map(symbol => (
                  <button key={symbol} onClick={() => toggleWatchlist(symbol)} className={`p-3 rounded-lg text-left ${watchlist.includes(symbol) ? 'bg-blue-600 hover:bg-blue-700' : 'bg-slate-700 hover:bg-slate-600'}`}>
                    <div className="font-bold">{symbol}</div>
                    <div className="text-sm text-slate-300">{STOCKS[symbol].name}</div>
                  </button>
                ))}
              </div>
              <div className="mt-4 flex justify-between items-center">
                <div className="text-sm text-slate-400">{watchlist.length} stocks selected</div>
                <button onClick={() => setShowWatchlistModal(false)} className="px-6 py-2 bg-green-600 hover:bg-green-700 rounded-lg font-semibold">
                  Done
                </button>
              </div>
            </div>
          </div>
        )}
      </div>
    </div>
  );
};

export default QuantTradingSimulator;
