      USDCHF: { volatility: 0.008, meanPrice: 0.9125, color: '#f59e0b', name: 'USD/CHF' },
      AUDUSD: { volatility: 0.011, meanPrice: 0.6235, color: '#8b5cf6', name: 'AUD/USD' },
