                <label className="text-sm font-medium block mb-2">Stop Loss: {stopLossPercent}%</label>
                <input type="range" min="1" max="20" value={stopLossPercent} onChange={(e) => setStopLossPercent(Number(e.target.value))} className="w-full" />
              </div>
              <div className="bg-slate-700 p-4 rounded-lg">
                <div className="flex items-center justify-between mb-2">
                  <label className="text-sm font-medium">Take Profit: {takeProfitPercent}%</label>
                  <button 
                    onClick={() => setAutoTakeProfit(!autoTakeProfit)}
                    className={`text-xs px-2 py-1 rounded ${autoTakeProfit ? 'bg-green-600' : 'bg-slate-600'}`}
                  >
                    {autoTakeProfit ? '🤖 AUTO' : '✋ MANUAL'}
                  </button>
                </div>
                <input 
                  type="range" 
                  min="5" 
                  max="50" 
                  value={takeProfitPercent} 
                  onChange={(e) => {
                    setTakeProfitPercent(Number(e.target.value));
                    setAutoTakeProfit(false);
                  }} 
                  className="w-full" 
                />
                {autoTakeProfit && (
                  <div className="text-xs text-green-400 mt-1">Auto-adjusts based on volatility & market regime</div>
                )}
              </div>
            </div>
          )}
        </div>

        <div className="grid grid-cols-2 md:grid-cols-5 gap-4">
          <div className="bg-slate-800 p-4 rounded-lg">
            <div className="text-sm text-slate-400">Portfolio Value</div>
            <div className="text-2xl font-bold">{formatCurrency(portfolio.totalValue)}</div>
          </div>
          <div className="bg-slate-800 p-4 rounded-lg">
            <div className="text-sm text-slate-400">Total Return</div>
            <div className={`text-2xl font-bold ${parseFloat(stats.totalReturn) >= 0 ? 'text-green-400' : 'text-red-400'}`}>
              {stats.totalReturn}%
            </div>
          </div>
          <div className="bg-slate-800 p-4 rounded-lg">
            <div className="text-sm text-slate-400">Sharpe Ratio</div>
            <div className="text-2xl font-bold text-blue-400">{stats.sharpeRatio}</div>
          </div>
          <div className="bg-slate-800 p-4 rounded-lg">
            <div className="text-sm text-slate-400">Win Rate</div>
            <div className="text-2xl font-bold text-purple-400">{stats.winRate}%</div>
          </div>
          <div className="bg-slate-800 p-4 rounded-lg">
            <div className="text-sm text-slate-400">Market Regime</div>
            <div className={`text-lg font-bold ${
              marketRegime === 'Crisis' ? 'text-red-500' :
              marketRegime === 'Bear Market' ? 'text-orange-500' :
              marketRegime === 'Bull Market' ? 'text-green-500' :
              'text-blue-400'
            }`}>{marketRegime}</div>
          </div>
        </div>

        <div className="bg-slate-800 p-6 rounded-lg">
          <div className="flex justify-between items-center mb-4">
            <h2 className="text-xl font-semibold">10-Bot Trading Council Performance 🤖</h2>
            <div className="flex items-center gap-4">
              <div className="text-sm text-slate-400">Vote Time: <span className="text-green-400 font-bold">{voteTime}ms</span></div>
              {nanoMode && <div className="text-xs text-yellow-400 font-bold animate-pulse">⚡ NANOSECOND MODE ACTIVE</div>}
            </div>
          </div>
          <div className="grid grid-cols-2 md:grid-cols-5 gap-3">
            {Object.entries(ensembleBotsDisplay).map(([name, bot]) => {
              const totalTrades = bot.wins + bot.losses;
              const winRate = totalTrades > 0 ? ((bot.wins / totalTrades) * 100).toFixed(1) : '0.0';
              const scoreColor = bot.score > 120 ? 'text-green-400' : bot.score > 80 ? 'text-blue-400' : bot.score > 50 ? 'text-yellow-400' : 'text-red-400';
              
              return (
                <div key={name} className="bg-slate-700 p-3 rounded-lg">
                  <div className="font-bold text-base capitalize mb-1">{name}</div>
                  <div className="text-xs text-slate-400 mb-2">{bot.description}</div>
                  <div className="space-y-1 text-xs">
                    <div className={`font-bold ${scoreColor}`}>Score: {bot.score.toFixed(0)}</div>
                    <div className="text-slate-300">W/L: {bot.wins}/{bot.losses}</div>
                    <div className="text-slate-300">Win: {winRate}%</div>
                    <div className={bot.totalPnL >= 0 ? 'text-green-400' : 'text-red-400'}>
                      {formatCurrency(bot.totalPnL)}
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </div>

        <div className="bg-slate-800 rounded-lg">
          <button onClick={() => toggleSection('voting')} className="w-full px-6 py-3 flex justify-between items-center hover:bg-slate-700 rounded-lg">
            <span className="font-bold text-lg">Live Council Voting</span>
            {expandedSection === 'voting' ? <ChevronUp size={20} /> : <ChevronDown size={20} />}
          </button>
          {expandedSection === 'voting' && (
            <div className="p-6 border-t border-slate-700 max-h-96 overflow-y-auto">
              {lastVote.length === 0 ? (
                <div className="text-slate-400 text-center py-8">No voting data yet. Start the simulation to see bot votes.</div>
              ) : (
                <div className="space-y-4">
                  {lastVote.slice(0, 5).map((vote, idx) => (
                    <div key={idx} className="bg-slate-700 p-4 rounded-lg">
                      <div className="font-bold text-lg mb-3">{vote.symbol}</div>
                      {vote.votes && vote.votes.length > 0 && (
                        <>
                          <div style={{ width: '100%', height: 150 }}>
                            <ResponsiveContainer>
                              <BarChart data={vote.votes} layout="vertical">
                                <CartesianGrid strokeDasharray="3 3" stroke="#334155" />
                                <XAxis type="number" stroke="#94a3b8" />
                                <YAxis dataKey="bot" type="category" stroke="#94a3b8" width={100} />
                                <Tooltip contentStyle={{ backgroundColor: '#1e293b', border: 'none' }} />
                                <Bar dataKey="score" fill="#3b82f6" label={{ position: 'right', fill: '#fff' }} />
                              </BarChart>
                            </ResponsiveContainer>
                          </div>
                          <div className="mt-2 text-sm text-slate-400 flex flex-wrap gap-3">
                            {vote.votes.map(v => (
                              <span key={v.bot} className="bg-slate-600 px-2 py-1 rounded">
                                {v.bot}: <span className={v.action === 'BUY' ? 'text-green-400' : 'text-red-400'}>{v.action}</span> ({v.score})
                              </span>
                            ))}
                          </div>
                        </>
                      )}
                    </div>
                  ))}
                </div>
              )}
            </div>
          )}
        </div>

        <div className="bg-slate-800 p-6 rounded-lg">
          <h2 className="text-xl font-semibold mb-4">Market Prices</h2>
          {marketData.length > 0 && (
            <ResponsiveContainer width="100%" height={300}>
              <LineChart data={marketData.slice(-60)}>
                <CartesianGrid strokeDasharray="3 3" stroke="#334155" />
                <XAxis dataKey="time" stroke="#94a3b8" />
                <YAxis stroke="#94a3b8" />
                <Tooltip contentStyle={{ backgroundColor: '#1e293b', border: 'none' }} />
                <Legend />
                <Line type="monotone" dataKey="AAPL" stroke="#3b82f6" dot={false} strokeWidth={2} />
                <Line type="monotone" dataKey="MSFT" stroke="#10b981" dot={false} strokeWidth={2} />
                <Line type="monotone" dataKey="NVDA" stroke="#f59e0b" dot={false} strokeWidth={2} />
                <Line type="monotone" dataKey="TSLA" stroke="#ef4444" dot={false} strokeWidth={2} />
              </LineChart>
            </ResponsiveContainer>
          )}
        </div>

        <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div className="bg-slate-800 rounded-lg">
            <button onClick={() => toggleSection('positions')} className="w-full px-6 py-3 flex justify-between items-center hover:bg-slate-700 rounded-t-lg">
              <span className="font-bold text-lg">Current Positions</span>
              {expandedSection === 'positions' ? <ChevronUp size={20} /> : <ChevronDown size={20} />}
            </button>
            {expandedSection === 'positions' && (
              <div className="p-6 space-y-2 max-h-96 overflow-y-auto border-t border-slate-700">
                {Object.keys(STOCKS).map(symbol => {
                  const shares = portfolio.positions[symbol] || 0;
                  const shorts = portfolio.shorts[symbol] || 0;
                  const price = marketData.length > 0 ? marketData[marketData.length - 1][symbol] : 0;
                  const entryPrice = portfolio.entryPrices[symbol];
                  const config = STOCKS[symbol];
                  const hasPosition = shares > 0 || shorts > 0;
                  
                  let pnlPercent = 0;
                  if (hasPosition && entryPrice) {
                    if (shares > 0) {
                      pnlPercent = ((price - entryPrice) / entryPrice) * 100;
                    } else {
                      pnlPercent = ((entryPrice - price) / entryPrice) * 100;
                    }
                  }
                  
                  return (
                    <div key={symbol} className={`p-3 rounded-lg ${hasPosition ? 'bg-slate-700' : 'bg-slate-700/30'}`}>
                      <div className="flex justify-between">
                        <div className="flex-1">
                          <div className="flex items-center gap-2">
                            <div className="w-3 h-3 rounded-full" style={{ backgroundColor: config.color }}></div>
                            <span className="font-bold">{symbol}</span>
                            <span className="text-xs text-slate-400">{config.sector}</span>
                          </div>
                          <div className="text-sm text-slate-400">
                            {shares > 0 && (
                              <div className="text-green-400">
                                LONG: {shares} @ £{entryPrice?.toFixed(2) || '0'} 
                                <span className={pnlPercent >= 0 ? 'text-green-300' : 'text-red-300'}>
                                  ({pnlPercent >= 0 ? '+' : ''}{pnlPercent.toFixed(1)}%)
                                </span>
                              </div>
                            )}
                            {shorts > 0 && (
                              <div className="text-red-400">
                                SHORT: {shorts} @ £{entryPrice?.toFixed(2) || '0'}
                                <span className={pnlPercent >= 0 ? 'text-green-300' : 'text-red-300'}>
                                  ({pnlPercent >= 0 ? '+' : ''}{pnlPercent.toFixed(1)}%)
                                </span>
                              </div>
                            )}
                            {!hasPosition && 'No position'}
                          </div>
                        </div>
                        {hasPosition && price && (
                          <div className="text-right">
                            {shares > 0 && <div className="font-bold text-green-400">£{(shares * price).toFixed(2)}</div>}
                            {shorts > 0 && <div className="font-bold text-red-400">-£{(shorts * price).toFixed(2)}</div>}
                          </div>
                        )}
                      </div>
                    </div>
                  );
                })}
              </div>
            )}
          </div>

          <div className="bg-slate-800 rounded-lg">
            <button onClick={() => toggleSection('trades')} className="w-full px-6 py-3 flex justify-between items-center hover:bg-slate-700 rounded-t-lg">
              <span className="font-bold text-lg">Recent Trades ({completedTradesRef.current.length})</span>
              {expandedSection === 'trades' ? <ChevronUp size={20} /> : <ChevronDown size={20} />}
            </button>
            {expandedSection === 'trades' && (
              <div className="p-6 space-y-2 max-h-96 overflow-y-auto border-t border-slate-700">
                {completedTradesRef.current.length === 0 ? (
                  <div className="text-slate-400 text-center py-8">No completed trades yet</div>
                ) : (
                  completedTradesRef.current.slice().reverse().map((trade, idx) => (
                    <div key={idx} className="p-3 bg-slate-700 rounded-lg text-sm">
                      <div className="flex justify-between items-start">
                        <div className="flex items-start gap-2 flex-1">
                          {trade.pnl >= 0 ? <TrendingUp className="text-green-400 mt-0.5" size={16} /> : <TrendingDown className="text-red-400 mt-0.5" size={16} />}
                          <div>
                            <div className="font-bold">{trade.symbol}</div>
                            <div className="text-xs text-slate-400">{trade.reason}</div>
                          </div>
                        </div>
                        <div className="text-right">
                          <div className={trade.pnl >= 0 ? 'text-green-400 font-bold' : 'text-red-400 font-bold'}>
                            {trade.pnl >= 0 ? '+' : ''}£{trade.pnl.toFixed(2)}
                          </div>
                          <div className="text-xs text-slate-400">
                            ({trade.pnlPercent >= 0 ? '+' : ''}{trade.pnlPercent.toFixed(2)}%)
                          </div>
                        </div>
                      </div>
                    </div>
                  ))
                )}
              </div>
            )}
          </div>
        </div>
        
        {showProfileModal && (
          <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
            <div className="bg-slate-800 rounded-lg p-6 max-w-4xl w-full max-h-[90vh] overflow-y-auto">
              <div className="flex justify-between items-center mb-4">
                <h2 className="text-2xl font-bold">Trading Profiles</h2>
                <button onClick={() => setShowProfileModal(false)} className="text-slate-400 hover:text-white text-2xl">×</button>
              </div>
              <div className="grid grid-cols-1 md:grid-cols-2 gap-3">
                <button onClick={() => applyProfile('conservative')} className="p-4 bg-slate-700 hover:bg-slate-600 rounded-lg text-left">
                  <div className="font-bold text-green-400 text-lg mb-2">🛡️ Conservative</div>
                  <div className="text-sm text-slate-300">Risk: 60% | Speed: 500ms | Stop: 7% | Take: 12% (Auto)</div>
                </button>
                <button onClick={() => applyProfile('balanced')} className="p-4 bg-slate-700 hover:bg-slate-600 rounded-lg text-left">
                  <div className="font-bold text-blue-400 text-lg mb-2">⚖️ Balanced</div>
                  <div className="text-sm text-slate-300">Risk: 65% | Speed: 100ms | Stop: 4% | Take: 15% (Auto)</div>
                </button>
                <button onClick={() => applyProfile('aggressive')} className="p-4 bg-slate-700 hover:bg-slate-600 rounded-lg text-left">
                  <div className="font-bold text-orange-400 text-lg mb-2">🔥 Aggressive</div>
                  <div className="text-sm text-slate-300">Risk: 75% | Speed: 20ms | Stop: 3% | Take: 20% (Auto)</div>
                </button>
                <button onClick={() => applyProfile('hft')} className="p-4 bg-slate-700 hover:bg-slate-600 rounded-lg text-left">
                  <div className="font-bold text-yellow-400 text-lg mb-2">⚡ HFT Algo</div>
                  <div className="text-sm text-slate-300">Risk: 85% | Speed: 1ns ⚡ | Stop: 3% | Take: 8% (Manual)</div>
                </button>
                <button onClick={() => applyProfile('daytrader')} className="p-4 bg-slate-700 hover:bg-slate-600 rounded-lg text-left">
                  <div className="font-bold text-purple-400 text-lg mb-2">📊 Day Trader</div>
                  <div className="text-sm text-slate-300">Risk: 75% | Speed: 50ms | Stop: 4% | Take: 12% (Auto)</div>
                </button>
                <button onClick={() => applyProfile('scalper')} className="p-4 bg-slate-700 hover:bg-slate-600 rounded-lg text-left">
                  <div className="font-bold text-red-400 text-lg mb-2">💨 Scalper</div>
                  <div className="text-sm text-slate-300">Risk: 90% | Speed: 1ns ⚡ | Stop: 2% | Take: 5% (Manual)</div>
                </button>
                <button onClick={() => applyProfile('swingtrader')} className="p-4 bg-slate-700 hover:bg-slate-600 rounded-lg text-left">
                  <div className="font-bold text-cyan-400 text-lg mb-2">🌊 Swing Trader</div>
                  <div className="text-sm text-slate-300">Risk: 65% | Speed: 1000ms | Stop: 8% | Take: 25% (Auto)</div>
                </button>
                <button onClick={() => applyProfile('whale')} className="p-4 bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-700 hover:to-pink-700 rounded-lg text-left">
                  <div className="font-bold text-white text-lg mb-2">🐋 Whale Mode</div>
                  <div className="text-sm text-white">Risk: 75% | Speed: 10ms | Capital: £100M | Auto TP</div>
                </button>
              </div>
            </div>
          </div>
        )}
        
        {showCapitalModal && (
          <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
            <div className="bg-slate-800 rounded-lg p-6 max-w-md w-full">
              <h2 className="text-2xl font-bold mb-4">Set Starting Capital</h2>
              <div className="space-y-4">
                <div>
                  <label className="text-sm text-slate-400 block mb-2">
                    Amount: {formatCurrency(startingCapital)}
                  </label>
                  <input type="number" min="1000" max="1000000000" step="1000" value={startingCapital} onChange={(e) => setStartingCapital(Math.max(1000, Number(e.target.value)))} className="w-full px-4 py-2 bg-slate-700 rounded text-white" />
                </div>
                <div className="grid grid-cols-3 gap-2">
                  <button onClick={() => setStartingCapital(10000)} className="px-3 py-2 bg-slate-700 hover:bg-slate-600 rounded text-sm">£10k</button>
                  <button onClick={() => setStartingCapital(100000)} className="px-3 py-2 bg-slate-700 hover:bg-slate-600 rounded text-sm">£100k</button>
                  <button onClick={() => setStartingCapital(1000000)} className="px-3 py-2 bg-slate-700 hover:bg-slate-600 rounded text-sm">£1M</button>
                  <button onClick={() => setStartingCapital(10000000)} className="px-3 py-2 bg-slate-700 hover:bg-slate-600 rounded text-sm">£10M</button>
                  <button onClick={() => setStartingCapital(100000000)} className="px-3 py-2 bg-slate-700 hover:bg-slate-600 rounded text-sm">£100M</button>
                </div>
                <div className="flex gap-3 mt-4">
                  <button onClick={() => { setShowCapitalModal(false); initializeMarket(); }} className="flex-1 px-6 py-2 bg-green-600 hover:bg-green-700 rounded-lg font-semibold">
                    Apply & Reset
                  </button>
                  <button onClick={() => setShowCapitalModal(false)} className="px-6 py-2 bg-slate-700 hover:bg-slate-600 rounded-lg font-semibold">
                    Cancel
                  </button>
                </div>
              </div>
            </div>
          </div>
        )}
        
        {showWatchlistModal && (
          <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
            <div className="bg-slate-800 rounded-lg p-6 max-w-4xl w-full max-h-[90vh] overflow-y-auto">
              <div className="flex justify-between items-center mb-4">
                <h2 className="text-2xl font-bold">Select Stocks for Watchlist</h2>
                <button onClick={() => setShowWatchlistModal(false)} className="text-slate-400 hover:text-white text-2xl">×</button>
              </div>
              <div className="grid grid-cols-1 md:grid-cols-2 gap-2">
                {Object.keys(STOCKS).map(symbol => (
                  <button key={symbol} onClick={() => toggleWatchlist(symbol)} className={`p-3 rounded-lg text-left ${watchlist.includes(symbol) ? 'bg-blue-600 hover:bg-blue-700' : 'bg-slate-700 hover:bg-slate-600'}`}>
                    <div className="font-bold">{symbol}</div>
                    <div className="text-sm text-slate-300">{STOCKS[symbol].name}</div>
                  </button>
                ))}
              </div>
              <div className="mt-4 flex justify-between items-center">
                <div className="text-sm text-slate-400">{watchlist.length} stocks selected</div>
                <button onClick={() => setShowWatchlistModal(false)} className="px-6 py-2 bg-green-600 hover:bg-green-700 rounded-lg font-semibold">
                  Done
                </button>
              </div>
            </div>
          </div>
        )}
      </div>
    </div>
  );
};

export default QuantTradingSimulator;
