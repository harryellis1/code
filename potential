                const shares = portfolio.positions[signal.symbol];
                const entryPrice = portfolio.entryPrices[signal.symbol] || price;
                const pnl = (price - entryPrice) * shares;

                portfolio.cash += shares * price;
                delete portfolio.positions[signal.symbol];
                delete portfolio.entryPrices[signal.symbol];
                delete portfolio.entryTimes[signal.symbol];
                if (portfolio.stopLosses) delete portfolio.stopLosses[signal.symbol];
                if (portfolio.takeProfits) delete portfolio.takeProfits[signal.symbol];

                completedTradesRef.current[marketType].push({
                  pnl,
                  pnlPercent: ((price - entryPrice) / entryPrice) * 100,
                  symbol: signal.symbol,
                  reason: signal.reason
                });
                if (completedTradesRef.current[marketType].length > 50) {
                  completedTradesRef.current[marketType].shift();
                }

                const tradeIdx = tradeHistoryRef.current[marketType].findIndex(t =>
                  t.symbol === signal.symbol && t.action === 'BUY' && t.shares === shares
                );
                if (tradeIdx !== -1) {
                  const trade = tradeHistoryRef.current[marketType][tradeIdx];
                  if (trade.bot) {
                    pendingBotUpdates.push({ bot: trade.bot, pnl });
                  }
                  tradeHistoryRef.current[marketType].splice(tradeIdx, 1);
                }
              } else if (signal.action === 'COVER' && portfolio.shorts[signal.symbol] > 0) {
                const shares = portfolio.shorts[signal.symbol];
                const entryPrice = portfolio.entryPrices[signal.symbol] || price;
                const pnl = (entryPrice - price) * shares;
                const coverCost = shares * price;

                if (portfolio.cash >= coverCost) {
                  portfolio.cash -= coverCost;
                  delete portfolio.shorts[signal.symbol];
                  delete portfolio.entryPrices[signal.symbol];
                  delete portfolio.entryTimes[signal.symbol];
                  if (portfolio.stopLosses) delete portfolio.stopLosses[signal.symbol];
                  if (portfolio.takeProfits) delete portfolio.takeProfits[signal.symbol];

                  completedTradesRef.current[marketType].push({
                    pnl,
                    pnlPercent: ((entryPrice - price) / entryPrice) * 100,
                    symbol: signal.symbol,
                    reason: signal.reason
                  });
                  if (completedTradesRef.current[marketType].length > 50) {
                    completedTradesRef.current[marketType].shift();
                  }

                  const tradeIdx = tradeHistoryRef.current[marketType].findIndex(t =>
                    t.symbol === signal.symbol && t.action === 'SHORT' && t.shares === shares
                  );
                  if (tradeIdx !== -1) {
                    const trade = tradeHistoryRef.current[marketType][tradeIdx];
                    if (trade.bot) {
                      pendingBotUpdates.push({ bot: trade.bot, pnl });
                    }
                    tradeHistoryRef.current[marketType].splice(tradeIdx, 1);
                  }
                }
              }
            });

            pendingBotUpdates.forEach(({ bot, pnl }) => {
              const botData = bots[bot];
              if (!botData) return;
              const reward = pnl > 0 ? Math.min(50, pnl / 100) : Math.max(-50, pnl / 50);
              botData.score = Math.max(10, Math.min(200, botData.score + reward));
              botData.wins = pnl > 0 ? botData.wins + 1 : botData.wins;
              botData.losses = pnl < 0 ? botData.losses + 1 : botData.losses;
              botData.totalPnL = botData.totalPnL + pnl;
            });

            let totalValue = portfolio.cash;
            Object.keys(portfolio.positions).forEach(sym => {
              if (newData[sym]) totalValue += portfolio.positions[sym] * newData[sym];
            });
            Object.keys(portfolio.shorts).forEach(sym => {
              if (newData[sym]) totalValue -= portfolio.shorts[sym] * newData[sym];
            });

            const peakValue = Math.max(portfolio.peakValue, totalValue);
            const newHistory = [...portfolio.history, totalValue];
            if (newHistory.length > 200) newHistory.shift();

            portfolio.totalValue = totalValue;
            portfolio.peakValue = peakValue;
            portfolio.history = newHistory;

