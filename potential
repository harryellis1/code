  }), []);

  const createInitialBots = useCallback(() => ({
    momentum: { score: 100, wins: 0, losses: 0, totalPnL: 0, description: 'RSI + MACD' },
    meanReversion: { score: 100, wins: 0, losses: 0, totalPnL: 0, description: 'Bollinger Bands' },
    breakout: { score: 100, wins: 0, losses: 0, totalPnL: 0, description: 'Volume + ATR' },
    volatility: { score: 100, wins: 0, losses: 0, totalPnL: 0, description: 'ATR + IV' },
    trend: { score: 100, wins: 0, losses: 0, totalPnL: 0, description: 'SMA crossovers' },
    fibonacci: { score: 100, wins: 0, losses: 0, totalPnL: 0, description: 'Fib retracements' }
  }), []);

  const createInitialPortfolio = useCallback((capital) => ({
    cash: capital,
    positions: {},
    shorts: {},
    entryPrices: {},
    entryTimes: {},
    stopLosses: {},
    takeProfits: {},
    totalValue: capital,
    history: [capital],
    peakValue: capital
  }), []);

  const generatePrice = useCallback((symbol, prevPrice, marketType, mode) => {
    const config = ASSETS[marketType][symbol];
    if (!config) return prevPrice;
    
    let volatilityMultiplier = 1;
    let trendBias = 0;

    if (mode === 'gorilla') volatilityMultiplier = 3;
    else if (mode === 'announcement') {
      volatilityMultiplier = 2;
      trendBias = marketTrend.current * 0.003;
    } else if (mode === 'crash') {
      volatilityMultiplier = 4;
      trendBias = -0.008;
    }

    if (marketType === 'crypto') volatilityMultiplier *= 1.5;

    const volatility = config.volatility * volatilityMultiplier;
    const randomShock = volatility * (Math.random() - 0.5) * 2;
    const marketShock = (marketFactorRef.current[marketType] - 1) * 0.02;
    const totalChange = prevPrice * (randomShock + marketShock + trendBias);
    const newPrice = Math.max(0.01, prevPrice + totalChange);
    return Math.max(config.meanPrice * 0.5, Math.min(config.meanPrice * 1.5, newPrice));
  }, [ASSETS]);

  const calculateRSI = useCallback((prices, period = 14) => {
    if (prices.length < period + 1) return 50;
    let gains = 0;
    let losses = 0;
    for (let i = prices.length - period; i < prices.length; i++) {
      if (i === 0) continue;
      const change = prices[i] - prices[i - 1];
      if (change > 0) gains += change;
      else losses += Math.abs(change);
    }
    const avgGain = gains / period;
    const avgLoss = losses / period;
    if (avgLoss < 0.0001) return avgGain > 0 ? 100 : 50;
    const rs = avgGain / avgLoss;
    return 100 - (100 / (1 + rs));
  }, []);

  const calculateBollingerBands = useCallback((prices, period = 20) => {
    if (prices.length < period) return { upper: 0, middle: 0, lower: 0, bandwidth: 0 };
    const slice = prices.slice(-period);
    const middle = slice.reduce((a, b) => a + b, 0) / period;
    const variance = slice.reduce((sum, p) => sum + Math.pow(p - middle, 2), 0) / period;
    const stdDev = Math.sqrt(variance);
    const upper = middle + (stdDev * 2);
    const lower = middle - (stdDev * 2);
    const bandwidth = (upper - lower) / middle;
    return { upper, middle, lower, bandwidth };
  }, []);

  const generateBotSignals = useCallback((symbol, prices, currentPrice, bots, useAutoMode) => {
    const botSignals = [];
    const rsi = calculateRSI(prices);
    const bb = calculateBollingerBands(prices);
    
    const ma5 = prices.slice(-5).reduce((a, b) => a + b, 0) / 5;
    const ma10 = prices.slice(-10).reduce((a, b) => a + b, 0) / 10;
    const ma20 = prices.slice(-20).reduce((a, b) => a + b, 0) / 20;
    const ma50 = prices.slice(-Math.min(50, prices.length)).reduce((a, b) => a + b, 0) / Math.min(50, prices.length);
    
    const momentum5 = (currentPrice - prices[prices.length - 5]) / Math.max(prices[prices.length - 5], 0.01);
    const momentum10 = (currentPrice - prices[prices.length - 10]) / Math.max(prices[prices.length - 10], 0.01);
    
    const slice30 = prices.slice(-30);
    const mean = slice30.reduce((a, b) => a + b, 0) / slice30.length;
    const variance = slice30.reduce((s, p) => s + Math.pow(p - mean, 2), 0) / slice30.length;
    const stdDev = Math.sqrt(variance);
    const zScore = stdDev > 0.01 ? (currentPrice - mean) / stdDev : 0;
    const bbPosition = bb.upper > bb.lower ? (currentPrice - bb.lower) / (bb.upper - bb.lower) : 0.5;

    // Calculate volume trend
    const recentVolatility = prices.slice(-10).reduce((sum, p, i, arr) => {
      if (i === 0) return sum;
      return sum + Math.abs((p - arr[i-1]) / arr[i-1]);
    }, 0) / 9;

    // Calculate ATR for dynamic stop loss/take profit
    let stopLoss, takeProfit;
    
    if (useAutoMode) {
      const atr = prices.length > 14 ? (() => {
        let trSum = 0;
        for (let i = prices.length - 14; i < prices.length; i++) {
          const high = prices[i];
          const low = prices[i] * 0.98;
          const prevClose = prices[i - 1];
          const tr = Math.max(high - low, Math.abs(high - prevClose), Math.abs(low - prevClose));
          trSum += tr;
        }
        return trSum / 14;
      })() : currentPrice * 0.02;

      const atrPercent = (atr / currentPrice) * 100;

      // MOMENTUM BOT - Ultra-responsive to momentum shifts
      if (rsi < 32 && momentum5 > 0.003 && momentum10 > -0.002 && ma5 > ma10) {
        stopLoss = Math.max(1.5, atrPercent * 1.1);
        takeProfit = Math.max(12, atrPercent * 6);
        botSignals.push({ 
          action: 'BUY', 
          confidence: 97, 
          bot: 'momentum', 
          weight: bots.momentum.score,
          stopLoss: stopLoss,
          takeProfit: takeProfit
        });
      } else if (rsi > 68 && momentum5 < -0.003 && momentum10 < 0.002 && ma5 < ma10) {
        stopLoss = Math.max(1.5, atrPercent * 1.1);
        takeProfit = Math.max(10, atrPercent * 5);
        botSignals.push({ 
          action: 'SHORT', 
          confidence: 95, 
          bot: 'momentum', 
          weight: bots.momentum.score,
          stopLoss: stopLoss,
          takeProfit: takeProfit
        });
      }
      
      // MEAN REVERSION BOT - Hair-trigger reversions
      if (bbPosition < 0.12 && zScore < -1.9 && rsi < 28 && momentum5 > -0.008) {
        stopLoss = Math.max(1.0, atrPercent * 0.8);
        takeProfit = Math.max(7, atrPercent * 3.5);
        botSignals.push({ 
          action: 'BUY', 
          confidence: 99, 
          bot: 'meanReversion', 
          weight: bots.meanReversion.score,
          stopLoss: stopLoss,
          takeProfit: takeProfit
        });
      } else if (bbPosition > 0.88 && zScore > 1.9 && rsi > 72 && momentum5 < 0.008) {
        stopLoss = Math.max(1.0, atrPercent * 0.8);
        takeProfit = Math.max(6, atrPercent * 3.2);
        botSignals.push({ 
          action: 'SHORT', 
          confidence: 97, 
          bot: 'meanReversion', 
          weight: bots.meanReversion.score,
          stopLoss: stopLoss,
          takeProfit: takeProfit
        });
      }
      
      // BREAKOUT BOT - Instant breakout detection
      if (currentPrice > bb.upper && momentum5 > 0.012 && recentVolatility > 0.012 && ma5 > ma10) {
        stopLoss = Math.max(2.0, atrPercent * 1.5);
        takeProfit = Math.max(18, atrPercent * 7);
        botSignals.push({ 
          action: 'BUY', 
          confidence: 94, 
          bot: 'breakout', 
          weight: bots.breakout.score,
          stopLoss: stopLoss,
          takeProfit: takeProfit
        });
      } else if (currentPrice < bb.lower && momentum5 < -0.012 && recentVolatility > 0.012 && ma5 < ma10) {
        stopLoss = Math.max(2.0, atrPercent * 1.5);
        takeProfit = Math.max(15, atrPercent * 6);
        botSignals.push({ 
          action: 'SHORT', 
          confidence: 92, 
          bot: 'breakout', 
          weight: bots.breakout.score,
          stopLoss: stopLoss,
          takeProfit: takeProfit
        });
      }

      // VOLATILITY BOT - Pre-emptive squeeze detection
      if (bb.bandwidth < 0.035 && rsi < 42 && recentVolatility < 0.012 && momentum10 > -0.005) {
        stopLoss = Math.max(1.8, atrPercent * 1.3);
        takeProfit = Math.max(14, atrPercent * 6.5);
        botSignals.push({ 
          action: 'BUY', 
          confidence: 91, 
          bot: 'volatility', 
          weight: bots.volatility.score,
          stopLoss: stopLoss,
          takeProfit: takeProfit
        });
      } else if (bb.bandwidth > 0.12 && recentVolatility > 0.03) {
        stopLoss = Math.max(2.2, atrPercent * 1.6);
        takeProfit = Math.max(8, atrPercent * 4);
        botSignals.push({ 
          action: 'SHORT', 
          confidence: 89, 
          bot: 'volatility', 
          weight: bots.volatility.score,
          stopLoss: stopLoss,
          takeProfit: takeProfit
        });
      }
      
      // TREND BOT - Rapid trend identification
      if (ma5 > ma10 && ma10 > ma20 && ma20 > ma50 && momentum10 > 0.01 && rsi > 42 && rsi < 68) {
        stopLoss = Math.max(2.2, atrPercent * 1.6);
        takeProfit = Math.max(20, atrPercent * 8);
        botSignals.push({ 
          action: 'BUY', 
          confidence: 96, 
          bot: 'trend', 
          weight: bots.trend.score,
          stopLoss: stopLoss,
          takeProfit: takeProfit
        });
      } else if (ma5 < ma10 && ma10 < ma20 && ma20 < ma50 && momentum10 < -0.01 && rsi < 58 && rsi > 32) {
        stopLoss = Math.max(2.2, atrPercent * 1.6);
        takeProfit = Math.max(17, atrPercent * 7);
        botSignals.push({ 
          action: 'SHORT', 
          confidence: 94, 
          bot: 'trend', 
          weight: bots.trend.score,
          stopLoss: stopLoss,
          takeProfit: takeProfit
        });
      }

      // FIBONACCI BOT - Lightning-fast fib retracements
      const fib382 = mean - stdDev * 0.382;
      const fib618 = mean - stdDev * 0.618;
      const fib1618 = mean + stdDev * 1.618;
      const fib2618 = mean + stdDev * 2.618;
      
      if (currentPrice <= fib618 && currentPrice >= fib382 * 0.98 && momentum5 > 0.005 && rsi < 38) {
        stopLoss = Math.max(1.3, atrPercent * 1.0);
        takeProfit = Math.max(11, atrPercent * 4.5);
        botSignals.push({ 
          action: 'BUY', 
          confidence: 92, 
          bot: 'fibonacci', 
          weight: bots.fibonacci.score,
          stopLoss: stopLoss,
          takeProfit: takeProfit
        });
      } else if (currentPrice >= fib1618 && momentum5 < -0.005 && rsi > 62) {
        stopLoss = Math.max(1.3, atrPercent * 1.0);
        takeProfit = Math.max(10, atrPercent * 4);
        botSignals.push({ 
          action: 'SHORT', 
          confidence: 90, 
          bot: 'fibonacci', 
          weight: bots.fibonacci.score,
          stopLoss: stopLoss,
          takeProfit: takeProfit
        });
      }
    } else {
      // Manual mode - use stricter entry conditions
      if (rsi < 32 && momentum5 > 0.003 && ma5 > ma10) {
        botSignals.push({ 
          action: 'BUY', 
          confidence: 97, 
          bot: 'momentum', 
          weight: bots.momentum.score,
          stopLoss: null,
          takeProfit: null
        });
      } else if (rsi > 68 && momentum5 < -0.003 && ma5 < ma10) {
        botSignals.push({ 
          action: 'SHORT', 
          confidence: 95, 
          bot: 'momentum', 
          weight: bots.momentum.score,
          stopLoss: null,
          takeProfit: null
        });
      }
      
      if (bbPosition < 0.12 && zScore < -1.9 && rsi < 28) {
        botSignals.push({ 
          action: 'BUY', 
          confidence: 99, 
          bot: 'meanReversion', 
          weight: bots.meanReversion.score,
          stopLoss: null,
          takeProfit: null
        });
      } else if (bbPosition > 0.88 && zScore > 1.9 && rsi > 72) {
        botSignals.push({ 
          action: 'SHORT', 
          confidence: 97, 
          bot: 'meanReversion', 
          weight: bots.meanReversion.score,
          stopLoss: null,
          takeProfit: null
        });
      }
      
      if (currentPrice > bb.upper && momentum5 > 0.012 && ma5 > ma10) {
        botSignals.push({ 
          action: 'BUY', 
          confidence: 94, 
          bot: 'breakout', 
          weight: bots.breakout.score,
          stopLoss: null,
          takeProfit: null
        });
      } else if (currentPrice < bb.lower && momentum5 < -0.012 && ma5 < ma10) {
        botSignals.push({ 
          action: 'SHORT', 
          confidence: 92, 
          bot: 'breakout', 
          weight: bots.breakout.score,
          stopLoss: null,
          takeProfit: null
        });
      }

      if (bb.bandwidth < 0.035 && rsi < 42) {
        botSignals.push({ 
          action: 'BUY', 
          confidence: 91, 
          bot: 'volatility', 
          weight: bots.volatility.score,
          stopLoss: null,
          takeProfit: null
        });
      }
      
      if (ma5 > ma10 && ma10 > ma20 && ma20 > ma50 && momentum10 > 0.01) {
        botSignals.push({ 
          action: 'BUY', 
          confidence: 96, 
          bot: 'trend', 
          weight: bots.trend.score,
          stopLoss: null,
          takeProfit: null
        });
      } else if (ma5 < ma10 && ma10 < ma20 && ma20 < ma50 && momentum10 < -0.01) {
        botSignals.push({ 
          action: 'SHORT', 
          confidence: 94, 
          bot: 'trend', 
          weight: bots.trend.score,
          stopLoss: null,
          takeProfit: null
        });
      }

      const fib618 = mean - stdDev * 0.618;
      const fib1618 = mean + stdDev * 1.618;
      if (currentPrice <= fib618 && momentum5 > 0.005 && rsi < 38) {
        botSignals.push({ 
          action: 'BUY', 
          confidence: 92, 
          bot: 'fibonacci', 
          weight: bots.fibonacci.score,
          stopLoss: null,
          takeProfit: null
        });
      } else if (currentPrice >= fib1618 && momentum5 < -0.005 && rsi > 62) {
        botSignals.push({ 
          action: 'SHORT', 
          confidence: 90, 
          bot: 'fibonacci', 
          weight: bots.fibonacci.score,
          stopLoss: null,
          takeProfit: null
        });
      }
    }
    
    return botSignals;
  }, [calculateRSI, calculateBollingerBands]);

  const initializeMarkets = useCallback(() => {
    const newMarkets = {};
    const capitalPerMarket = startingCapital / 4;

    ['stocks', 'crypto', 'forex', 'commodities'].forEach(marketType => {
      const initial = { time: 0 };
      Object.keys(ASSETS[marketType]).forEach(symbol => {
        initial[symbol] = ASSETS[marketType][symbol].meanPrice;
      });

      newMarkets[marketType] = {
        data: [initial],
        portfolio: createInitialPortfolio(capitalPerMarket),
        stats: { totalReturn: 0, winRate: 0, totalTrades: 0, sharpeRatio: 0 },
        bots: createInitialBots()
      };
    });

    setMarkets(newMarkets);
    setLastVote({});
    completedTradesRef.current = { stocks: [], crypto: [], forex: [], commodities: [] };
    tradeHistoryRef.current = { stocks: [], crypto: [], forex: [], commodities: [] };
    timeStep.current = 0;
    marketFactorRef.current = { stocks: 1.0, crypto: 1.0, forex: 1.0, commodities: 1.0 };
  }, [startingCapital, ASSETS, createInitialPortfolio, createInitialBots]);

  useEffect(() => {
    initializeMarkets();
  }, [initializeMarkets]);

  useEffect(() => {
    if (intervalRef.current) clearInterval(intervalRef.current);
    if (tradeIntervalRef.current) clearInterval(tradeIntervalRef.current);
    
    if (isRunning) {
      intervalRef.current = setInterval(() => {
        setMarkets(prevMarkets => {
          const newMarkets = JSON.parse(JSON.stringify(prevMarkets));

          ['stocks', 'crypto', 'forex', 'commodities'].forEach(marketType => {
            if (newMarkets[marketType].data.length === 0) return;
            const lastData = newMarkets[marketType].data[newMarkets[marketType].data.length - 1];

            if (marketMode === 'announcement') {
              marketTrend.current = Math.random() > 0.5 ? 1 : -1;
              marketFactorRef.current[marketType] += marketTrend.current * 0.02;
            } else if (marketMode === 'crash') {
              marketFactorRef.current[marketType] -= 0.015;
            } else {
              marketFactorRef.current[marketType] += (Math.random() - 0.5) * 0.01;
            }
            marketFactorRef.current[marketType] = Math.max(0.7, Math.min(1.3, marketFactorRef.current[marketType]));

            const newData = { time: timeStep.current + 1 };
            Object.keys(ASSETS[marketType]).forEach(symbol => {
              if (lastData[symbol] !== undefined) {
                newData[symbol] = generatePrice(symbol, lastData[symbol], marketType, marketMode);
              }
            });

            const allData = [...newMarkets[marketType].data, newData];
            if (allData.length > 200) allData.shift();
            newMarkets[marketType].data = allData;

            const portfolio = newMarkets[marketType].portfolio;
            let totalValue = portfolio.cash;
            Object.keys(portfolio.positions).forEach(sym => {
              if (newData[sym]) totalValue += portfolio.positions[sym] * newData[sym];
            });
            Object.keys(portfolio.shorts).forEach(sym => {
              if (newData[sym]) totalValue -= portfolio.shorts[sym] * newData[sym];
            });

            const newHistory = [...portfolio.history, totalValue];
            if (newHistory.length > 200) newHistory.shift();

            newMarkets[marketType].portfolio.totalValue = totalValue;
            newMarkets[marketType].portfolio.history = newHistory;
            newMarkets[marketType].portfolio.peakValue = Math.max(portfolio.peakValue, totalValue);
          });

          timeStep.current++;
          return newMarkets;
        });
      }, 50);
      
      tradeIntervalRef.current = setInterval(() => {
        setMarkets(prevMarkets => {
          if (prevMarkets.stocks.data.length < 30) return prevMarkets;
          
          const voteStartTime = performance.now();
          const newMarkets = JSON.parse(JSON.stringify(prevMarkets));
          const allVotes = {};

          ['stocks', 'crypto', 'forex', 'commodities'].forEach(marketType => {
            const marketData = newMarkets[marketType].data;
            if (marketData.length < 30) return;

            const newData = marketData[marketData.length - 1];
            const signals = [];
            const exitSignals = [];
            const portfolio = newMarkets[marketType].portfolio;
            const bots = newMarkets[marketType].bots;
            const marketVotes = [];

            Object.keys(ASSETS[marketType]).forEach(symbol => {
              if (!newData[symbol]) return;
              const prices = marketData.map(d => d[symbol]).filter(p => p !== undefined);
              if (prices.length < 30) return;

              const currentPrice = prices[prices.length - 1];
              const botSignals = generateBotSignals(symbol, prices, currentPrice, bots, autoMode);

              if (botSignals.length > 0) {
                const scored = botSignals.map(s => ({
                  ...s,
                  score: s.confidence * (s.weight / 100)
                })).sort((a, b) => b.score - a.score);

                marketVotes.push({
                  symbol,
                  votes: scored.slice(0, 4).map(s => ({ 
                    bot: s.bot, 
                    score: s.score.toFixed(1), 
                    action: s.action 
                  }))
                });

                const best = scored[0];
                if (best.score >= riskTolerance) {
                  signals.push({ 
                    symbol, 
                    action: best.action, 
                    bot: best.bot, 
                    entryPrice: currentPrice,
                    stopLoss: best.stopLoss,
                    takeProfit: best.takeProfit
                  });
                }
              }

              if (portfolio.positions[symbol] > 0) {
                const entryPrice = portfolio.entryPrices[symbol];
                const tradeStopLoss = portfolio.stopLosses?.[symbol] || stopLossPercent;
                const tradeTakeProfit = portfolio.takeProfits?.[symbol] || takeProfitPercent;
                
                if (entryPrice) {
                  const pnlPercent = ((currentPrice - entryPrice) / entryPrice) * 100;
                  
                  // Take profit
                  if (pnlPercent >= tradeTakeProfit) {
                    exitSignals.push({ symbol, action: 'SELL', reason: `TP ${pnlPercent.toFixed(1)}%` });
                  } 
                  // Stop loss
                  else if (pnlPercent <= -tradeStopLoss) {
                    exitSignals.push({ symbol, action: 'SELL', reason: `SL ${pnlPercent.toFixed(1)}%` });
                  }
                  // Trailing stop for profits > 50% of target
                  else if (pnlPercent > tradeTakeProfit * 0.5) {
                    const trailingStop = pnlPercent * 0.6; // Lock in 60% of gains
                    const currentDrawdown = pnlPercent - ((currentPrice - prices[prices.length - 2]) / entryPrice) * 100;
                    if (currentDrawdown > trailingStop * 0.4) {
                      exitSignals.push({ symbol, action: 'SELL', reason: `Trail ${pnlPercent.toFixed(1)}%` });
                    }
                  }
                }
              }

              if (portfolio.shorts[symbol] > 0) {
                const entryPrice = portfolio.entryPrices[symbol];
                const tradeStopLoss = portfolio.stopLosses?.[symbol] || stopLossPercent;
                const tradeTakeProfit = portfolio.takeProfits?.[symbol] || takeProfitPercent * 0.8;
                
                if (entryPrice) {
                  const pnlPercent = ((entryPrice - currentPrice) / entryPrice) * 100;
                  
                  // Take profit
                  if (pnlPercent >= tradeTakeProfit) {
                    exitSignals.push({ symbol, action: 'COVER', reason: `TP ${pnlPercent.toFixed(1)}%` });
                  } 
                  // Stop loss
                  else if (pnlPercent <= -tradeStopLoss) {
                    exitSignals.push({ symbol, action: 'COVER', reason: `SL ${pnlPercent.toFixed(1)}%` });
                  }
                  // Trailing stop for shorts
                  else if (pnlPercent > tradeTakeProfit * 0.5) {
                    const trailingStop = pnlPercent * 0.6;
                    const currentDrawdown = pnlPercent - ((entryPrice - prices[prices.length - 2]) / entryPrice) * 100;
                    if (currentDrawdown > trailingStop * 0.4) {
                      exitSignals.push({ symbol, action: 'COVER', reason: `Trail ${pnlPercent.toFixed(1)}%` });
                    }
                  }
                }
              }
