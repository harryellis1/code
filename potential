  });
  
  const ensembleBotsRef = useRef({
    momentum: { score: 100, wins: 0, losses: 0, totalPnL: 0, description: 'RSI + MACD momentum' },
    meanReversion: { score: 100, wins: 0, losses: 0, totalPnL: 0, description: 'Bollinger Bands + Z-Score' },
    breakout: { score: 100, wins: 0, losses: 0, totalPnL: 0, description: 'Volume + ATR breakouts' },
    volatility: { score: 100, wins: 0, losses: 0, totalPnL: 0, description: 'ATR + IV analysis' },
    trend: { score: 100, wins: 0, losses: 0, totalPnL: 0, description: 'SMA crossovers + ADX' },
    fibonacci: { score: 100, wins: 0, losses: 0, totalPnL: 0, description: 'Fib retracements' },
    ichimoku: { score: 100, wins: 0, losses: 0, totalPnL: 0, description: 'Ichimoku Cloud' },
    stochastic: { score: 100, wins: 0, losses: 0, totalPnL: 0, description: 'Stochastic oscillator' },
    macd: { score: 100, wins: 0, losses: 0, totalPnL: 0, description: 'MACD histogram' },
    vwap: { score: 100, wins: 0, losses: 0, totalPnL: 0, description: 'VWAP deviation' }
  });
  const [ensembleBotsDisplay, setEnsembleBotsDisplay] = useState(ensembleBotsRef.current);
  
  const votingCacheRef = useRef(new Map());
  const priceHistoryRef = useRef({});
  
  const tradeHistoryRef = useRef([]);
  const completedTradesRef = useRef([]);
  const timeStep = useRef(0);
  const intervalRef = useRef(null);
  const tradeIntervalRef = useRef(null);
  const marketFactor = useRef(1.0);
  const marketTrend = useRef(0);

  const STOCKS = useMemo(() => ({
    AAPL: { sector: 'tech', beta: 1.25, volatility: 0.018, meanPrice: 230, color: '#3b82f6', name: 'Apple Inc.' },
    MSFT: { sector: 'tech', beta: 1.15, volatility: 0.016, meanPrice: 500, color: '#10b981', name: 'Microsoft Corp.' },
    NVDA: { sector: 'tech', beta: 1.75, volatility: 0.032, meanPrice: 185, color: '#f59e0b', name: 'NVIDIA Corp.' },
    TSLA: { sector: 'auto', beta: 2.00, volatility: 0.038, meanPrice: 430, color: '#ef4444', name: 'Tesla Inc.' },
    GOOGL: { sector: 'tech', beta: 1.10, volatility: 0.019, meanPrice: 195, color: '#8b5cf6', name: 'Alphabet Inc.' },
    AMZN: { sector: 'retail', beta: 1.30, volatility: 0.022, meanPrice: 230, color: '#ec4899', name: 'Amazon.com Inc.' },
    META: { sector: 'tech', beta: 1.40, volatility: 0.025, meanPrice: 640, color: '#06b6d4', name: 'Meta Platforms' },
    JPM: { sector: 'finance', beta: 1.15, volatility: 0.020, meanPrice: 260, color: '#84cc16', name: 'JPMorgan Chase' },
    BAC: { sector: 'finance', beta: 1.20, volatility: 0.021, meanPrice: 48, color: '#f97316', name: 'Bank of America' },
    WMT: { sector: 'retail', beta: 0.60, volatility: 0.013, meanPrice: 105, color: '#14b8a6', name: 'Walmart Inc.' },
    JNJ: { sector: 'healthcare', beta: 0.70, volatility: 0.012, meanPrice: 155, color: '#a855f7', name: 'Johnson & Johnson' },
    PFE: { sector: 'healthcare', beta: 0.65, volatility: 0.018, meanPrice: 26, color: '#f43f5e', name: 'Pfizer Inc.' },
    XOM: { sector: 'energy', beta: 1.05, volatility: 0.024, meanPrice: 120, color: '#eab308', name: 'Exxon Mobil' },
    CVX: { sector: 'energy', beta: 1.00, volatility: 0.023, meanPrice: 165, color: '#22c55e', name: 'Chevron Corp.' },
    DIS: { sector: 'media', beta: 1.20, volatility: 0.021, meanPrice: 115, color: '#6366f1', name: 'Walt Disney Co.' },
    NFLX: { sector: 'media', beta: 1.50, volatility: 0.028, meanPrice: 980, color: '#dc2626', name: 'Netflix Inc.' },
    BA: { sector: 'aerospace', beta: 1.60, volatility: 0.030, meanPrice: 180, color: '#0ea5e9', name: 'Boeing Co.' },
    AMD: { sector: 'tech', beta: 1.80, volatility: 0.035, meanPrice: 145, color: '#d946ef', name: 'AMD Inc.' },
    INTC: { sector: 'tech', beta: 1.10, volatility: 0.022, meanPrice: 22, color: '#78716c', name: 'Intel Corp.' },
    KO: { sector: 'consumer', beta: 0.55, volatility: 0.011, meanPrice: 68, color: '#16a34a', name: 'Coca-Cola Co.' }
  }), []);

  const generatePrice = useCallback((symbol, prevPrice, mode) => {
    const config = STOCKS[symbol];
    if (!config) return prevPrice;
    
    let volatilityMultiplier = 1;
    let trendBias = 0;

    if (mode === 'livemarket') volatilityMultiplier = 0.8;
    else if (mode === 'gorilla') volatilityMultiplier = 3;
    else if (mode === 'announcement') {
      volatilityMultiplier = 2;
      trendBias = marketTrend.current * 0.003;
    } else if (mode === 'crash') {
      volatilityMultiplier = 4;
      trendBias = -0.008;
    }

    const volatility = config.volatility * volatilityMultiplier;
    const randomShock = volatility * (Math.random() - 0.5) * 2;
    const marketShock = config.beta * (marketFactor.current - 1) * 0.02;
    const totalChange = prevPrice * (randomShock + marketShock + trendBias);
    const newPrice = Math.max(0.01, prevPrice + totalChange);
    return Math.max(config.meanPrice * 0.3, Math.min(config.meanPrice * 2.0, newPrice));
  }, [STOCKS]);

  const calculateRSI = useCallback((prices, period = 14) => {
    if (prices.length < period + 1) return 50;
    let gains = 0, losses = 0;
    for (let i = prices.length - period; i < prices.length; i++) {
      if (i === 0) continue;
      const change = prices[i] - prices[i - 1];
      if (change > 0) gains += change;
      else losses += Math.abs(change);
    }
    const avgGain = gains / period;
    const avgLoss = losses / period;
    if (avgLoss < 0.0001) return avgGain > 0 ? 100 : 50;
    const rs = avgGain / avgLoss;
    return 100 - (100 / (1 + rs));
  }, []);

  const calculateMACD = useCallback((prices) => {
    if (prices.length < 26) return { macd: 0, signal: 0, histogram: 0 };
    
    const ema12 = prices.slice(-12).reduce((a, b) => a + b, 0) / 12;
    const ema26 = prices.slice(-26).reduce((a, b) => a + b, 0) / 26;
    const macd = ema12 - ema26;
    const signal = macd * 0.8;
    const histogram = macd - signal;
    
    return { macd, signal, histogram };
  }, []);

  const calculateBollingerBands = useCallback((prices, period = 20) => {
    if (prices.length < period) return { upper: 0, middle: 0, lower: 0, bandwidth: 0 };
    
    const slice = prices.slice(-period);
    const middle = slice.reduce((a, b) => a + b, 0) / period;
    const variance = slice.reduce((sum, p) => sum + Math.pow(p - middle, 2), 0) / period;
    const stdDev = Math.sqrt(variance);
    
    const upper = middle + (stdDev * 2);
    const lower = middle - (stdDev * 2);
    const bandwidth = (upper - lower) / middle;
    
    return { upper, middle, lower, bandwidth };
  }, []);

  const calculateATR = useCallback((prices, period = 14) => {
    if (prices.length < period + 1) return 0;
    
    let trSum = 0;
    for (let i = prices.length - period; i < prices.length; i++) {
      const high = prices[i];
      const low = prices[i] * 0.98;
      const prevClose = prices[i - 1];
      const tr = Math.max(high - low, Math.abs(high - prevClose), Math.abs(low - prevClose));
      trSum += tr;
    }
    
    return trSum / period;
  }, []);

  const calculateStochastic = useCallback((prices, period = 14) => {
    if (prices.length < period) return { k: 50, d: 50 };
    
    const slice = prices.slice(-period);
    const currentPrice = prices[prices.length - 1];
    const lowest = Math.min(...slice);
    const highest = Math.max(...slice);
    
    const k = highest > lowest ? ((currentPrice - lowest) / (highest - lowest)) * 100 : 50;
    const d = k * 0.9;
    
    return { k, d };
  }, []);

  const calculateADX = useCallback((prices, period = 14) => {
    if (prices.length < period + 1) return 0;
    
    let dmPlus = 0, dmMinus = 0;
    for (let i = prices.length - period; i < prices.length; i++) {
      const upMove = prices[i] - prices[i - 1];
      const downMove = prices[i - 1] - prices[i];
      if (upMove > downMove && upMove > 0) dmPlus += upMove;
      if (downMove > upMove && downMove > 0) dmMinus += downMove;
    }
    
    const adx = Math.abs(dmPlus - dmMinus) / (dmPlus + dmMinus + 0.0001) * 100;
    return adx;
  }, []);

  const calculateVWAP = useCallback((prices, volumes) => {
    if (prices.length < 20) return prices[prices.length - 1];
    
    const slice = prices.slice(-20);
    const volSlice = volumes.slice(-20);
    
    let cumVol = 0, cumPV = 0;
    for (let i = 0; i < slice.length; i++) {
      cumVol += volSlice[i];
      cumPV += slice[i] * volSlice[i];
    }
    
    return cumVol > 0 ? cumPV / cumVol : slice[slice.length - 1];
  }, []);

  const generateBotSignals = useCallback((symbol, prices, volumes, currentPrice, marketInfo, bots) => {
    const botSignals = [];
    
    const rsi = calculateRSI(prices);
    const rsi9 = calculateRSI(prices, 9);
    const macd = calculateMACD(prices);
    const bb = calculateBollingerBands(prices);
    const atr = calculateATR(prices);
    const stoch = calculateStochastic(prices);
    const adx = calculateADX(prices);
    const vwap = calculateVWAP(prices, volumes);
    
    const ma5 = prices.slice(-5).reduce((a, b) => a + b, 0) / 5;
    const ma10 = prices.slice(-10).reduce((a, b) => a + b, 0) / 10;
    const ma20 = prices.slice(-20).reduce((a, b) => a + b, 0) / 20;
    const ma50 = prices.slice(-Math.min(50, prices.length)).reduce((a, b) => a + b, 0) / Math.min(50, prices.length);
    
    const momentum5 = (currentPrice - prices[prices.length - 5]) / Math.max(prices[prices.length - 5], 0.01);
    const momentum10 = (currentPrice - prices[prices.length - 10]) / Math.max(prices[prices.length - 10], 0.01);
    
    const slice30 = prices.slice(-30);
    const mean = slice30.reduce((a, b) => a + b, 0) / slice30.length;
    const variance = slice30.reduce((s, p) => s + Math.pow(p - mean, 2), 0) / slice30.length;
    const stdDev = Math.sqrt(variance);
    const zScore = stdDev > 0.01 ? (currentPrice - mean) / stdDev : 0;
    
    const bbPosition = bb.upper > bb.lower ? (currentPrice - bb.lower) / (bb.upper - bb.lower) : 0.5;
    const vwapDev = Math.abs(currentPrice - vwap) / vwap;
    
    const fib618 = mean - stdDev * 0.618;
    const tenkan = (Math.max(...prices.slice(-9)) + Math.min(...prices.slice(-9))) / 2;
    const kijun = (Math.max(...prices.slice(-26)) + Math.min(...prices.slice(-26))) / 2;
    
    // Enhanced momentum conditions
    if (rsi < 35 && macd.histogram > 0 && momentum5 > 0.003 && adx > 20) {
      botSignals.push({ action: 'BUY', confidence: 94, bot: 'momentum', weight: bots.momentum.score });
    } else if (rsi > 65 && macd.histogram < 0 && momentum5 < -0.003) {
      botSignals.push({ action: 'SHORT', confidence: 92, bot: 'momentum', weight: bots.momentum.score });
    }
    
    // Enhanced mean reversion with tighter bands
    if (bbPosition < 0.15 && zScore < -1.8 && momentum5 > -0.01) {
      botSignals.push({ action: 'BUY', confidence: 96, bot: 'meanReversion', weight: bots.meanReversion.score });
    } else if (bbPosition > 0.85 && zScore > 1.8 && momentum5 < 0.01) {
      botSignals.push({ action: 'SHORT', confidence: 94, bot: 'meanReversion', weight: bots.meanReversion.score });
    }
    
    // Enhanced breakout with volume confirmation
    if (currentPrice > bb.upper && atr > mean * 0.018 && momentum5 > 0.015 && adx > 25) {
      botSignals.push({ action: 'BUY', confidence: 91, bot: 'breakout', weight: bots.breakout.score });
    }
    
    // Volatility squeeze plays
    if (bb.bandwidth < 0.04 && rsi < 45 && momentum10 > 0) {
      botSignals.push({ action: 'BUY', confidence: 88, bot: 'volatility', weight: bots.volatility.score });
    } else if (bb.bandwidth > 0.15 && marketInfo.regime === 'Crisis') {
      botSignals.push({ action: 'SHORT', confidence: 95, bot: 'volatility', weight: bots.volatility.score });
    }
    
    // Strong trend following with confirmation
    if (ma5 > ma10 && ma10 > ma20 && ma20 > ma50 && adx > 28 && momentum10 > 0.01) {
      botSignals.push({ action: 'BUY', confidence: 93, bot: 'trend', weight: bots.trend.score });
    } else if (ma5 < ma10 && ma10 < ma20 && ma20 < ma50 && adx > 28 && momentum10 < -0.01) {
      botSignals.push({ action: 'SHORT', confidence: 91, bot: 'trend', weight: bots.trend.score });
    }
    
    // Fibonacci with momentum confirmation
    if (currentPrice <= fib618 && momentum5 > 0.005 && rsi < 40) {
      botSignals.push({ action: 'BUY', confidence: 89, bot: 'fibonacci', weight: bots.fibonacci.score });
    } else if (currentPrice >= mean + stdDev * 1.618 && momentum5 < -0.005) {
      botSignals.push({ action: 'SHORT', confidence: 87, bot: 'fibonacci', weight: bots.fibonacci.score });
    }
    
    // Ichimoku with all signals aligned
    if (currentPrice > tenkan && tenkan > kijun && currentPrice > ma50 && adx > 22) {
      botSignals.push({ action: 'BUY', confidence: 92, bot: 'ichimoku', weight: bots.ichimoku.score });
    } else if (currentPrice < tenkan && tenkan < kijun && currentPrice < ma50) {
      botSignals.push({ action: 'SHORT', confidence: 89, bot: 'ichimoku', weight: bots.ichimoku.score });
    }
    
    // Stochastic with RSI confirmation
    if (stoch.k < 25 && stoch.k > stoch.d && rsi < 38 && momentum5 > 0) {
      botSignals.push({ action: 'BUY', confidence: 93, bot: 'stochastic', weight: bots.stochastic.score });
    } else if (stoch.k > 75 && stoch.k < stoch.d && rsi > 62) {
      botSignals.push({ action: 'SHORT', confidence: 91, bot: 'stochastic', weight: bots.stochastic.score });
    }
    
    // MACD with strong momentum
    if (macd.macd > macd.signal && macd.histogram > 0.3 && rsi9 < 65 && momentum5 > 0.008) {
      botSignals.push({ action: 'BUY', confidence: 92, bot: 'macd', weight: bots.macd.score });
    } else if (macd.macd < macd.signal && macd.histogram < -0.3 && momentum5 < -0.008) {
      botSignals.push({ action: 'SHORT', confidence: 90, bot: 'macd', weight: bots.macd.score });
    }
    
    // VWAP mean reversion
    if (currentPrice < vwap * 0.975 && momentum5 > 0.005 && rsi < 42) {
      botSignals.push({ action: 'BUY', confidence: 88, bot: 'vwap', weight: bots.vwap.score });
    } else if (currentPrice > vwap * 1.025 && vwapDev > 0.025 && momentum5 < -0.005) {
      botSignals.push({ action: 'SHORT', confidence: 86, bot: 'vwap', weight: bots.vwap.score });
    }
    
    return botSignals;
  }, [calculateRSI, calculateMACD, calculateBollingerBands, calculateATR, calculateStochastic, calculateADX, calculateVWAP]);

  const detectMarketCondition = useCallback((data) => {
    if (data.length < 30) return { regime: 'Normal' };
    const recent = data.slice(-30);
    let totalChange = 0, volatilitySum = 0;
    const symbols = Object.keys(STOCKS);
    
    symbols.forEach(symbol => {
      const prices = recent.map(d => d[symbol]).filter(p => p !== undefined);
      if (prices.length < 30) return;
      
      const change = (prices[prices.length - 1] - prices[0]) / prices[0];
      totalChange += change;
      
      let varianceSum = 0;
      for (let i = 1; i < prices.length; i++) {
        const ret = (prices[i] - prices[i-1]) / Math.max(prices[i-1], 0.01);
        varianceSum += ret * ret;
      }
      volatilitySum += Math.sqrt(varianceSum / (prices.length - 1));
    });
    
    const avgChange = totalChange / symbols.length;
    const avgVol = volatilitySum / symbols.length;
    
    if (avgChange < -0.10 && avgVol > 0.025) return { regime: 'Crisis' };
    if (avgChange < -0.05 && avgVol > 0.020) return { regime: 'Bear Market' };
    if (avgVol > 0.030) return { regime: 'Panic Selling' };
    if (Math.abs(avgChange) > 0.08) return { regime: avgChange > 0 ? 'Bull Market' : 'Distribution' };
    return { regime: 'Normal' };
  }, [STOCKS]);

  const initializeMarket = useCallback(() => {
    const initial = { time: 0 };
    Object.keys(STOCKS).forEach(symbol => {
      initial[symbol] = STOCKS[symbol].meanPrice;
    });
    setMarketData([initial]);
    setPortfolio({
      cash: startingCapital,
      positions: {},
      shorts: {},
      entryPrices: {},
      entryTimes: {},
      totalValue: startingCapital,
      history: [startingCapital],
      peakValue: startingCapital
    });
    setStats({ totalReturn: 0, winRate: 0, totalTrades: 0, sharpeRatio: 0, drawdown: 0 });
    ensembleBotsRef.current = {
      momentum: { score: 100, wins: 0, losses: 0, totalPnL: 0, description: 'RSI + MACD momentum' },
      meanReversion: { score: 100, wins: 0, losses: 0, totalPnL: 0, description: 'Bollinger Bands + Z-Score' },
      breakout: { score: 100, wins: 0, losses: 0, totalPnL: 0, description: 'Volume + ATR breakouts' },
      volatility: { score: 100, wins: 0, losses: 0, totalPnL: 0, description: 'ATR + IV analysis' },
      trend: { score: 100, wins: 0, losses: 0, totalPnL: 0, description: 'SMA crossovers + ADX' },
      fibonacci: { score: 100, wins: 0, losses: 0, totalPnL: 0, description: 'Fib retracements' },
      ichimoku: { score: 100, wins: 0, losses: 0, totalPnL: 0, description: 'Ichimoku Cloud' },
      stochastic: { score: 100, wins: 0, losses: 0, totalPnL: 0, description: 'Stochastic oscillator' },
      macd: { score: 100, wins: 0, losses: 0, totalPnL: 0, description: 'MACD histogram' },
      vwap: { score: 100, wins: 0, losses: 0, totalPnL: 0, description: 'VWAP deviation' }
    };
    setEnsembleBotsDisplay({...ensembleBotsRef.current});
    tradeHistoryRef.current = [];
    completedTradesRef.current = [];
    timeStep.current = 0;
    marketFactor.current = 1.0;
    setLastVote([]);
    setVoteTime(0);
  }, [startingCapital, STOCKS]);

  useEffect(() => {
    initializeMarket();
  }, [initializeMarket]);

  useEffect(() => {
    if (intervalRef.current) clearInterval(intervalRef.current);
    if (tradeIntervalRef.current) clearInterval(tradeIntervalRef.current);
    
    if (isRunning) {
      intervalRef.current = setInterval(() => {
        setMarketData(prevData => {
          if (prevData.length === 0) return prevData;
          const lastData = prevData[prevData.length - 1];

          if (marketMode === 'announcement') {
            marketTrend.current = Math.random() > 0.5 ? 1 : -1;
            marketFactor.current += marketTrend.current * 0.02;
          } else if (marketMode === 'crash') {
            marketFactor.current -= 0.015;
          } else {
            marketFactor.current += (Math.random() - 0.5) * 0.01;
          }
          marketFactor.current = Math.max(0.7, Math.min(1.3, marketFactor.current));

          const newData = { time: timeStep.current + 1 };
          const symbolsToUpdate = marketMode === 'livemarket' && watchlist.length > 0 ? watchlist : Object.keys(STOCKS);
          
          symbolsToUpdate.forEach(symbol => {
            if (STOCKS[symbol] && lastData[symbol] !== undefined) {
              newData[symbol] = generatePrice(symbol, lastData[symbol], marketMode);
            }
          });

          Object.keys(STOCKS).forEach(symbol => {
            if (newData[symbol] === undefined) {
              newData[symbol] = lastData[symbol] || STOCKS[symbol].meanPrice;
            }
          });

          timeStep.current++;
          
          setPortfolio(prev => {
            let totalValue = prev.cash;
            Object.keys(prev.positions).forEach(sym => {
              if (newData[sym]) totalValue += prev.positions[sym] * newData[sym];
            });
            Object.keys(prev.shorts).forEach(sym => {
              if (newData[sym]) totalValue -= prev.shorts[sym] * newData[sym];
            });
            
            const newHistory = [...prev.history, totalValue];
            if (newHistory.length > 200) newHistory.shift();
            
            return {
              ...prev,
              totalValue,
              history: newHistory,
              peakValue: Math.max(prev.peakValue, totalValue)
            };
          });

          const allData = [...prevData, newData];
          if (allData.length > 200) allData.shift();
          return allData;
        });
      }, 50);
      
      tradeIntervalRef.current = setInterval(() => {
        setMarketData(prevData => {
          if (prevData.length < 30) return prevData;
          
          const voteStartTime = performance.now();
          const newData = prevData[prevData.length - 1];
          const marketInfo = detectMarketCondition(prevData);
          setMarketRegime(marketInfo.regime);
          
          const voteData = [];
          const signals = [];
          const activeSymbols = marketMode === 'livemarket' && watchlist.length > 0 ? watchlist : Object.keys(STOCKS);
          
          activeSymbols.forEach(symbol => {
            if (!newData[symbol]) return;
            const prices = prevData.map(d => d[symbol]).filter(p => p !== undefined);
            if (prices.length < 30) return;
            
            const currentPrice = prices[prices.length - 1];
            const volumes = prices.map((p, i) => Math.random() * 1000000);
            
            const cacheKey = `${symbol}_${currentPrice.toFixed(2)}`;
            let botSignals = votingCacheRef.current.get(cacheKey);
            
            if (!botSignals) {
              botSignals = generateBotSignals(symbol, prices, volumes, currentPrice, marketInfo, ensembleBotsRef.current);
              votingCacheRef.current.set(cacheKey, botSignals);
              if (votingCacheRef.current.size > 100) {
                const firstKey = votingCacheRef.current.keys().next().value;
                votingCacheRef.current.delete(firstKey);
              }
            }
            
            let decision = 'HOLD';
            let confidence = 50;
            let selectedBot = null;
            
            if (botSignals.length > 0) {
              const scored = botSignals.map(s => ({
                ...s,
