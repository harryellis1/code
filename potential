              const hasLong = (portfolio.positions[signal.symbol] || 0) > 0;
              const hasShort = (portfolio.shorts[signal.symbol] || 0) > 0;

              if (signal.action === 'BUY' && availableCash > price * 5 && !hasLong && !hasShort) {
                const positionSize = availableCash * (investmentPercent / 100);
                const shares = Math.floor(positionSize / price);
                if (shares > 0 && portfolio.cash >= shares * price + reserveAmount) {
                  portfolio.cash -= shares * price;
                  portfolio.positions[signal.symbol] = shares;
                  portfolio.entryPrices[signal.symbol] = price;
                  portfolio.entryTimes[signal.symbol] = timeStep.current;
                  
